@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var email = User.Identity?.Name ?? "User";
    var initials = string.Concat(email.TakeWhile(c => c != '@').Take(2)).ToUpper();
    if (initials.Length == 0) initials = "U";

    <ul class="navbar-nav">
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="na-admin-pill" asp-area="" asp-controller="Admin" asp-action="Index" title="管理面板 Admin Panel">
                    <i class="bi bi-shield-lock-fill"></i> <span class="d-none d-sm-inline">Admin Panel</span>
                </a>
            </li>
        }
        <li class="nav-item dropdown na-user-menu">
            <a class="nav-link na-user-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="na-avatar">@initials</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end na-dropdown" aria-labelledby="userDropdown">
                <li class="dropdown-header">
                    <div class="na-dropdown-email">@email</div>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person"></i> My profile
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a class="dropdown-item" asp-area="" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-lock"></i> Admin panel
                        </a>
                    </li>
                }
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="About">
                        <i class="bi bi-info-circle"></i> About
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item na-dropdown-logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link na-nav-link-sm" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
        <li class="nav-item">
            <a class="btn-na-primary btn-sm ms-1" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
        </li>
    </ul>
}
