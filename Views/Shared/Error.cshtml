@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="na-error-page" aria-labelledby="error-title">
    <div class="na-error-petals" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="na-error-mark" aria-hidden="true"><i class="bi bi-cloud-sun"></i></div>
    <p class="na-error-kicker">A SHORT PAUSE · ひと休み</p>
    <h1 id="error-title">Something went wrong</h1>
    <p class="na-error-ja">申し訳ありません</p>
    <p class="na-error-copy">We couldn't complete that request. Your learning progress is safe, so you can return and continue studying.</p>
    <div class="na-error-actions">
        <a asp-controller="Home" asp-action="Index" class="btn-na-primary"><i class="bi bi-house-door"></i> Go home</a>
        <a asp-controller="Lessons" asp-action="Index" class="btn-na-outline"><i class="bi bi-book"></i> Browse lessons</a>
    </div>
    @if (Model.ShowRequestId)
    {
        <details class="na-error-reference">
            <summary>Technical reference</summary>
            <code>@Model.RequestId</code>
        </details>
    }
</section>

<partial name="_ErrorPageStyles" />
