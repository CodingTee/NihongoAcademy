@*
    Unified Empty State partial
    Usage: <partial name="_EmptyState" model='new EmptyStateViewModel { Icon = "bi-inbox", Title = "No lessons found", Message = "Try a different search.", ActionText = "Browse lessons", ActionUrl = Url.Action("Index", "Lessons") }' />
*@
@model NihongoAcademy.Helpers.EmptyStateViewModel

<div class="na-card text-center py-5">
    <i class="bi @Model.Icon" style="font-size: 3rem; color: var(--na-text-muted);"></i>
    <h4 class="mt-3">@Model.Title</h4>
    <p class="text-muted">@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.ActionText) && Model.ActionUrl != null)
    {
        <a href="@Model.ActionUrl" class="btn-na-outline btn-sm mt-2">
            <i class="bi bi-arrow-right"></i> @Model.ActionText
        </a>
    }
</div>
