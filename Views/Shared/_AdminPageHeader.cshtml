@model NihongoAcademy.Models.AdminPageHeaderModel
@{
    var last = Model.Trail.Count - 1;
}
<nav class="na-admin-crumb" aria-label="Breadcrumb">
    @for (var i = 0; i <= last; i++)
    {
        var item = Model.Trail[i];
        if (i > 0)
        {
            <span class="na-admin-crumb-sep" aria-hidden="true">/</span>
        }
        if (i == last)
        {
            <span class="na-admin-crumb-current">@item.Text</span>
        }
        else
        {
            <a class="na-admin-crumb-link" href="@item.Url">@item.Text</a>
        }
    }
</nav>

<header class="na-admin-pagehead">
    <div class="na-admin-pagehead-text">
        <h1 class="na-admin-pagehead-title">
            @if (!string.IsNullOrEmpty(Model.Icon))
            {
                <i class="bi @Model.Icon" aria-hidden="true"></i>
            }
            @Model.Title
            @if (!string.IsNullOrEmpty(Model.TitleJp))
            {
                <span class="na-admin-pagehead-jp">@Model.TitleJp</span>
            }
        </h1>
        @if (!string.IsNullOrEmpty(Model.Lead))
        {
            <p class="na-admin-pagehead-lead">@Model.Lead</p>
        }
    </div>
    @if (Model.Actions.Any() || !string.IsNullOrEmpty(Model.ActionsHtml))
    {
        <div class="na-admin-pagehead-actions">
            @foreach (var a in Model.Actions)
            {
                <a class="@(a.Outline ? "btn-na-outline" : "btn-na-primary") @a.CssClass" href="@a.Url">
                    @if (!string.IsNullOrEmpty(a.Icon))
                    {
                        <i class="bi @a.Icon" aria-hidden="true"></i>
                    }
                    <span>@a.Text</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.ActionsHtml))
            {
                @Html.Raw(Model.ActionsHtml)
            }
        </div>
    }
</header>
