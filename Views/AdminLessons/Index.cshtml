@model IEnumerable<NihongoAcademy.Models.Lesson>

@{
    ViewData["Title"] = "Manage Lessons";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Lessons" }
    },
    Icon = "bi-journal-text",
    Title = "Manage Lessons",
    TitleJp = "レッスン管理",
    Lead = "Create, order, and publish learning content.",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "New Lesson", Url = Url.Action("Editor", "AdminContent", new { type = "lesson", mode = "create" }), Icon = "bi-plus-circle" }
    }
})

<div class="na-card-flat">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Difficulty</th>
                    <th>Published</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.JapaneseTitle))
                            {
                                <br /><small class="text-na-primary">@item.JapaneseTitle</small>
                            }
                        </td>
                        <td><span class="na-badge na-badge-@(item.Category?.Name?.ToLower())">@item.Category?.Name</span></td>
                        <td>
                            @for (int i = 0; i < item.DifficultyLevel; i++)
                            {
                                <i class="bi bi-star-fill text-warning small"></i>
                            }
                        </td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-muted"></i>
                            }
                        </td>
                        <td>@item.DisplayOrder</td>
                        <td>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="lesson" asp-route-mode="details" asp-route-id="@item.Id" class="na-icon-btn" title="View" aria-label="View lesson"><i class="bi bi-eye"></i></a>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="lesson" asp-route-mode="edit" asp-route-id="@item.Id" class="na-icon-btn" title="Edit" aria-label="Edit lesson"><i class="bi bi-pencil"></i></a>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="lesson" asp-route-mode="delete" asp-route-id="@item.Id" class="na-icon-btn na-icon-danger" title="Delete" aria-label="Delete lesson"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
