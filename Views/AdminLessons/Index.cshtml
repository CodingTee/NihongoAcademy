@model IEnumerable<NihongoAcademy.Models.Lesson>

@{
    ViewData["Title"] = "Manage Lessons";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text"></i> Manage Lessons</h2>
    <a asp-action="Create" class="btn-na-primary"><i class="bi bi-plus-circle"></i> New Lesson</a>
</div>

<div class="na-card-flat">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Difficulty</th>
                    <th>Published</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.JapaneseTitle))
                            {
                                <br /><small class="text-na-primary">@item.JapaneseTitle</small>
                            }
                        </td>
                        <td><span class="na-badge na-badge-@(item.Category?.Name?.ToLower())">@item.Category?.Name</span></td>
                        <td>
                            @for (int i = 0; i < item.DifficultyLevel; i++)
                            {
                                <i class="bi bi-star-fill text-warning small"></i>
                            }
                        </td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-muted"></i>
                            }
                        </td>
                        <td>@item.DisplayOrder</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline" style="color: #D44;"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
