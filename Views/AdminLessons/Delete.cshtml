@model NihongoAcademy.Models.Lesson

@{
    ViewData["Title"] = "Delete Lesson";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Delete Lesson" }
    },
    Icon = "bi-trash",
    Title = "Delete Lesson",
    TitleJp = "レッスン削除",
    Lead = Model.Title,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }), Icon = "bi-arrow-left", Outline = true }
    }
})

@{
    var learnerRecords = ViewBag.LearnerRecords is int lr ? lr : 0;
    var activityCount = ViewBag.ActivityCount is int ac ? ac : 0;
    var vocabularyLinkCount = ViewBag.VocabularyLinkCount is int vlc ? vlc : 0;
    var grammarLinkCount = ViewBag.GrammarLinkCount is int glc ? glc : 0;
    var skillTaskCount = ViewBag.SkillTaskCount is int stc ? stc : 0;
    var contentCount = activityCount + vocabularyLinkCount + grammarLinkCount + skillTaskCount;
}

<div class="na-card-flat" style="border-color: #ee96a4;">
    @if (learnerRecords > 0)
    {
        <div class="alert alert-danger mb-3">
            <i class="bi bi-shield-exclamation"></i> This lesson has <strong>@learnerRecords</strong> learner record(s).
            Deleting it would erase that study history — unpublish the lesson instead. The delete will be rejected.
        </div>
    }
    <p class="text-danger">Are you sure you want to delete this lesson?</p>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Japanese Title</dt>
        <dd class="col-sm-9">@Model.JapaneseTitle</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
    </dl>

    @if (contentCount > 0)
    {
        <div class="alert alert-warning mb-3">
            <strong><i class="bi bi-exclamation-triangle"></i> The following content will be permanently deleted with this lesson:</strong>
            <ul class="mb-0 mt-2">
                @if (activityCount > 0)
                {
                    <li>@activityCount structured activity(ies)</li>
                }
                @if (vocabularyLinkCount > 0)
                {
                    <li>@vocabularyLinkCount vocabulary link(s)</li>
                }
                @if (grammarLinkCount > 0)
                {
                    <li>@grammarLinkCount grammar point link(s)</li>
                }
                @if (skillTaskCount > 0)
                {
                    <li>@skillTaskCount linked skill task(s) (listening / reading / speaking / writing)</li>
                }
            </ul>
        </div>
    }

    <form asp-controller="AdminLessons" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger" @(learnerRecords > 0 ? "disabled" : "")><i class="bi bi-trash"></i> Delete</button>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="lesson" class="btn-na-outline">Cancel</a>
    </form>
</div>
