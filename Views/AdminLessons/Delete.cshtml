@model NihongoAcademy.Models.Lesson

@{
    ViewData["Title"] = "Delete Lesson";
}

<h2><i class="bi bi-trash text-danger"></i> Delete Lesson</h2>

<div class="na-card-flat" style="border-color: #D44;">
    <p class="text-danger">Are you sure you want to delete this lesson?</p>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Japanese Title</dt>
        <dd class="col-sm-9">@Model.JapaneseTitle</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn-na-outline">Cancel</a>
    </form>
</div>
