@model NihongoAcademy.Models.Lesson

@{
    ViewData["Title"] = "Create Lesson";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Create Lesson" }
    },
    Icon = "bi-journal-plus",
    Title = "Create New Lesson",
    TitleJp = "レッスン作成",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="row">
    <div class="col-12">
        <div class="na-card-flat">
            <form asp-controller="AdminLessons" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(ViewBag.Categories != null ? new SelectList(ViewBag.Categories, "Id", "Name") : null)">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JapaneseTitle" class="form-label"></label>
                    <input asp-for="JapaneseTitle" class="form-control" placeholder="日本語タイトル" />
                    <span asp-validation-for="JapaneseTitle" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <partial name="_RichTextEditor" for="Content" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DifficultyLevel" class="form-label"></label>
                        <input asp-for="DifficultyLevel" class="form-control" type="number" min="1" max="5" />
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="EstimatedMinutes" class="form-label"></label>
                        <input asp-for="EstimatedMinutes" class="form-control" type="number" min="1" />
                        <span asp-validation-for="EstimatedMinutes" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="VideoUrl" class="form-label"></label>
                    <input asp-for="VideoUrl" class="form-control" placeholder="https://..." />
                    <span asp-validation-for="VideoUrl" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-na-primary"><i class="bi bi-check-circle"></i> Create</button>
                    <a asp-controller="AdminContent" asp-action="Index" asp-route-type="lesson" class="btn-na-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
