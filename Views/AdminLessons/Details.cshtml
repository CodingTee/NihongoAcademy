@model NihongoAcademy.Models.Lesson

@{
    ViewData["Title"] = "Lesson Details";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Details" }
    },
    Icon = "bi-eye",
    Title = "Lesson Details",
    TitleJp = "レッスン詳細",
    Lead = Model.Title,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Lessons", Url = Url.Action("Index", "AdminContent", new { type = "lesson" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat">
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Title)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.JapaneseTitle)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.JapaneseTitle)</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9"><span class="na-badge na-badge-@(Model.Category?.Name?.ToLower())">@Model.Category?.Name</span></dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(m => m.Description)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DifficultyLevel)</dt>
        <dd class="col-sm-9">@for (int i = 0; i < Model.DifficultyLevel; i++) { <i class="bi bi-star-fill text-warning"></i> }</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.EstimatedMinutes)</dt>
        <dd class="col-sm-9">@Model.EstimatedMinutes minutes</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsPublished)</dt>
        <dd class="col-sm-9">@(Model.IsPublished ? "Yes" : "No")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DisplayOrder)</dt>
        <dd class="col-sm-9">@Model.DisplayOrder</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedDate)</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToString("MMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</dd>
    </dl>

    <hr />
    <h6>Content Preview</h6>
    <div class="content-html p-3" style="background: var(--na-bg); border-radius: 8px;">
        @Html.Raw(Model.Content)
    </div>

    <div class="mt-3">
        <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="lesson" asp-route-mode="edit" asp-route-id="@Model.Id" class="btn-na-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="lesson" class="btn-na-outline">Back to List</a>
    </div>
</div>
