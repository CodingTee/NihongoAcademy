@* ===== CTA for non-logged-in ===== *@
@if (!isLoggedIn)
{
    <div class="na-card text-center mt-3" style="background: var(--na-sakura-light);">
        <h4>Ready to start your journey?</h4>
        <p class="text-muted mb-2">Sign up for free to track your progress, save flashcards, and join the community.</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-na-primary">
            <i class="bi bi-person-plus"></i> Create Free Account
        </a>
    </div>
