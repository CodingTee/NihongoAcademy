@model NihongoAcademy.Controllers.HomeViewModel
@using System.Globalization
@using NihongoAcademy.Services

@{
    ViewData["Title"] = "Home";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var hasContinueLearning = isLoggedIn && Model.ContinueLearning.Any();
    var hasNextLessons = isLoggedIn && !Model.ContinueLearning.Any() && Model.NextLessons.Any();

}

@* ===== 1. Hero (interactive carousel) ===== *@
<section class="na-hero-v2" aria-label="Welcome" data-hero-carousel>
    <div class="na-hero-v2-deco" aria-hidden="true">
        <span class="na-hero-v2-tree" aria-hidden="true"></span>
        <span class="na-hero-v2-line na-hero-v2-line--1"></span>
        <span class="na-hero-v2-line na-hero-v2-line--2"></span>
    </div>

    @* Viewport: owns the horizontal clip for the sliding track.
       The clip MUST stay on this untransformed wrapper - never on
       .na-hero-v2-slides itself (see site.css for the full explanation). *@
    <div class="na-hero-v2-viewport">
    <div class="na-hero-v2-slides">
        @* Slide 1: Welcome *@
        <div class="na-hero-v2-slide is-active" data-slide="0">
            <div class="na-hero-v2-inner">
                <span class="na-hero-v2-eyebrow"><i class="bi bi-stars"></i> Welcome to Nihongo Academy</span>
                <h1 class="na-hero-v2-title">Learn Japanese<br /><span>with Confidence</span></h1>
                <p class="na-hero-v2-title-ja">日本語を楽しく学ぼう</p>
                <p class="na-hero-v2-lead">
                    Master hiragana, katakana, vocabulary, and grammar through interactive lessons designed for real progress.
                </p>
                <div class="na-hero-v2-cta">
                    @if (!isLoggedIn)
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn-na-primary btn-lg">
                            <i class="bi bi-person-plus"></i> Start Learning
                        </a>
                        <a asp-controller="Lessons" asp-action="Index" class="btn-na-outline btn-lg">
                            <i class="bi bi-journal-text"></i> Explore Lessons
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Lessons" asp-action="Index" class="btn-na-primary btn-lg">
                            <i class="bi bi-journal-text"></i> Browse Lessons
                        </a>
                        <a asp-controller="Practice" asp-action="Index" class="btn-na-outline btn-lg">
                            <i class="bi bi-pencil-square"></i> Practice Now
                        </a>
                    }
                </div>
            </div>
        </div>

        @* Slide 2: The three scripts — centered single column (matches slide 1) *@
        <div class="na-hero-v2-slide" data-slide="1">
            <div class="na-hero-v2-inner">
                <span class="na-hero-v2-eyebrow"><i class="bi bi-pencil"></i> The three scripts</span>
                <h1 class="na-hero-v2-title">Master Hiragana,<br /><span>Katakana &amp; Kanji</span></h1>
                <p class="na-hero-v2-title-ja">ひらがな・カタカナ・漢字</p>
                <p class="na-hero-v2-lead">
                    Step-by-step lessons, guided handwriting grids and smart drills carry you
                    from your very first あ to confident, fluent reading.
                </p>
                <div class="na-hero-v2-cta">
                    <a asp-controller="Lessons" asp-action="Index" class="btn-na-primary btn-lg">
                        <i class="bi bi-journal-text"></i> Browse Lessons
                    </a>
                    <a asp-controller="Practice" asp-action="Index" class="btn-na-outline btn-lg">
                        <i class="bi bi-vector-pen"></i> Start Drills
                    </a>
                </div>
            </div>
        </div>

        @* Slide 3: Interactive Japan map — centered single column (matches slide 1) *@
        <div class="na-hero-v2-slide" data-slide="2">
            <div class="na-hero-v2-inner">
                <span class="na-hero-v2-eyebrow"><i class="bi bi-geo-alt"></i> Interactive Japan map</span>
                <h1 class="na-hero-v2-title">Discover Japan's<br /><span>Nine Regions</span></h1>
                <p class="na-hero-v2-title-ja">9つの地方</p>
                <p class="na-hero-v2-lead">
                    From snow-covered Hokkaidō in the north to the subtropical Ryūkyū islands
                    in the south — explore each region's capital, cuisine, and culture.
                </p>
                <div class="na-hero-v2-cta">
                    <a asp-controller="ExploreJapan" asp-action="Browse" asp-route-type="regions" class="btn-na-primary btn-lg">
                        <i class="bi bi-map"></i> Explore All Regions
                    </a>
                    <a asp-controller="ExploreJapan" asp-action="Index" class="btn-na-outline btn-lg">
                        <i class="bi bi-compass"></i> Open the Map
                    </a>
                </div>
            </div>
        </div>
    </div>
    </div>

    <div class="na-hero-v2-dots" aria-label="Hero slides">
        <button type="button" class="na-hero-v2-dot is-active" data-slide="0" aria-label="Show slide 1"></button>
        <button type="button" class="na-hero-v2-dot" data-slide="1" aria-label="Show slide 2"></button>
        <button type="button" class="na-hero-v2-dot" data-slide="2" aria-label="Show slide 3"></button>
    </div>
</section>

@* ===== 2. Continue Learning / Next Lesson ===== *@
@if (hasContinueLearning)
{
    <section class="na-continue-highlight" aria-labelledby="continue-title">
        <div class="na-section-heading-v2">
            <span class="na-kicker">Pick up where you left off</span>
            <h2 id="continue-title">Continue Learning <span>学習を続ける</span></h2>
        </div>
        @foreach (var progress in Model.ContinueLearning.Take(1))
        {
            var actionLabel = progress.CompletionPercentage == 0 ? "Start Lesson" : "Continue";
            var actionIcon = progress.CompletionPercentage == 0 ? "bi-play-fill" : "bi-arrow-right";
            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@progress.LessonId" class="na-continue-card-v2">
                <div>
                    <span class="na-badge na-badge-@(progress.Lesson?.Category?.Name?.ToLower())">@progress.Lesson?.Category?.Name</span>
                    <h4>@progress.Lesson?.Title</h4>
                    @if (!string.IsNullOrEmpty(progress.Lesson?.JapaneseTitle))
                    {
                        <p class="ja">@progress.Lesson.JapaneseTitle</p>
                    }
                    <div class="meta">
                        <span data-pct-text="@progress.LessonId"><i class="bi bi-bar-chart"></i> @progress.CompletionPercentage% complete</span>
                        @if (progress.Lesson?.EstimatedMinutes > 0)
                        {
                            var remaining = Math.Max(1, (int)Math.Ceiling(progress.Lesson.EstimatedMinutes * (100 - progress.CompletionPercentage) / 100.0));
                            <span data-remaining="@progress.LessonId"> · <i class="bi bi-clock"></i> ~@remaining min left</span>
                        }
                    </div>
                    <div class="progress-wrap">
                        <div class="na-progress--inline">
                            <div class="na-progress-fill" data-progress-bar="@progress.LessonId" style="width: @progress.CompletionPercentage%"></div>
                        </div>
                    </div>
                </div>
                <div data-action="@progress.LessonId">
                    <span class="btn-na-primary"><i class="@actionIcon"></i> @actionLabel</span>
                </div>
            </a>
        }
    </section>
}
else if (hasNextLessons)
{
    <section class="na-continue-highlight" aria-labelledby="next-title">
        <div class="na-section-heading-v2">
            <span class="na-kicker">Ready for more?</span>
            <h2 id="next-title">Start Your Next Lesson <span>次のレッスン</span></h2>
        </div>
        @foreach (var lesson in Model.NextLessons.Take(1))
        {
            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id" class="na-continue-card-v2">
                <div>
                    <span class="na-badge na-badge-@(lesson.Category?.Name?.ToLower())">@lesson.Category?.Name</span>
                    <h4>@lesson.Title</h4>
                    @if (!string.IsNullOrEmpty(lesson.JapaneseTitle))
                    {
                        <p class="ja">@lesson.JapaneseTitle</p>
                    }
                    <div class="meta">
                        <span><i class="bi bi-clock"></i> @lesson.EstimatedMinutes min</span>
                    </div>
                </div>
                <div>
                    <span class="btn-na-primary"><i class="bi bi-play-fill"></i> Start Lesson</span>
                </div>
            </a>
        }
    </section>
}

@* ===== 3. Learning path timeline ===== *@
<section class="na-timeline-section" aria-labelledby="timeline-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Structured path</span>
        <h2 id="timeline-title">Your learning journey <span>学習コース</span></h2>
        <p>Start with the scripts, progress through practical A1 and A2 Japanese, and build kanji step by step.</p>
    </div>
    <div class="na-path-grid">
        @{
            var categories = Model.Categories.Where(c => c.Lessons.Any()).Take(8).ToList();
            for (int i = 0; i < categories.Count; i++)
            {
                var cat = categories[i];
                var tone = (i % 4) + 1;
                var name = cat.Name ?? "";
                var icon = name.Contains("Hiragana") || name.Contains("Katakana") ? "bi-type-bold"
                         : name.Contains("Kanji") ? "bi-brush"
                         : name.Contains("Vocabulary") ? "bi-journal-bookmark-fill"
                         : name.Contains("Grammar") ? "bi-diagram-3-fill"
                         : name.Contains("Culture") ? "bi-flower3"
                         : name.Contains("A1") || name.Contains("A2") ? "bi-signpost-2-fill"
                         : "bi-book-fill";
                var href = isLoggedIn
                    ? Url.Action("Index", "Lessons")
                    : Url.Page("/Account/Login", new { area = "Identity", returnUrl = "/Lessons" });
                <a href="@href" class="na-path-card na-path-card--@tone">
                    <div class="na-path-card-top">
                        <span class="na-path-num">@((i + 1).ToString("D2"))</span>
                        <span class="na-path-icon"><i class="bi @icon"></i></span>
                    </div>
                    <h3>@cat.Name</h3>
                    <p>@cat.Lessons.Count lesson@(cat.Lessons.Count == 1 ? "" : "s") to build your skills.</p>
                </a>
            }
        }
    </div>
</section>

@* ===== 4. Stats ===== *@
<section class="na-home-overview-v2" aria-labelledby="stats-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Explore the academy</span>
        <h2 id="stats-title">Everything you need to keep moving</h2>
        <p>Preview the learning experience now. Sign in to save progress, unlock your next lesson and receive personalised review.</p>
    </div>
    <div class="na-home-stats-v2">
        <div class="na-home-stat-v2"><strong>@Model.TotalLessons</strong><span>guided lessons</span></div>
        <div class="na-home-stat-v2"><strong>@Model.TotalVocabulary</strong><span>study items</span></div>
        <div class="na-home-stat-v2"><strong>@Model.TotalQuizzes</strong><span>knowledge checks</span></div>
        <div class="na-home-stat-v2"><strong>@Model.Categories.Count</strong><span>learning areas</span></div>
    </div>
</section>

@* ===== 5. Why learn / benefits ===== *@
<section class="na-why-section" aria-labelledby="why-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Why Nihongo Academy?</span>
        <h2 id="why-title">A smarter way to learn Japanese</h2>
        <p>Combine structured lessons with interactive practice and community support.</p>
    </div>
    <div class="na-why-grid">
        <article class="na-why-card">
            <i class="bi bi-book"></i>
            <h4>Structured lessons</h4>
            <p>Follow a carefully sequenced path from your first kana to real conversations.</p>
        </article>
        <article class="na-why-card">
            <i class="bi bi-headphones"></i>
            <h4>Interactive practice</h4>
            <p>Train listening, recall, handwriting and reading with instant feedback.</p>
        </article>
        <article class="na-why-card">
            <i class="bi bi-people"></i>
            <h4>Community &amp; culture</h4>
            <p>Explore Japan's regions and discuss questions with fellow learners.</p>
        </article>
    </div>
</section>

@* ===== 6. Featured Lessons ===== *@
<section class="na-home-compartment-v2" aria-labelledby="featured-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Start with a real lesson</span>
        <h2 id="featured-title">Featured lessons <span>おすすめ</span></h2>
        <p>@(string.IsNullOrWhiteSpace(Model.RecommendationReason) ? "A preview of the carefully sequenced material waiting in your learning path." : Model.RecommendationReason)</p>
    </div>
    <div class="na-home-card-grid-v2">
        @foreach (var lesson in Model.RecommendedLessons.Take(6))
        {
            var lessonHref = isLoggedIn
                ? Url.Action("Details", "Lessons", new { id = lesson.Id })
                : Url.Page("/Account/Login", new { area = "Identity", returnUrl = $"/Lessons/Details/{lesson.Id}" });
            <a href="@lessonHref" class="na-home-content-card-v2">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <span class="na-badge na-badge-@(lesson.Category?.Name?.ToLower())">@lesson.Category?.Name</span>
                    <span class="small text-muted"><i class="bi bi-clock"></i> @lesson.EstimatedMinutes min</span>
                </div>
                <h4>@lesson.Title</h4>
                <div class="ja">@lesson.JapaneseTitle</div>
                <p>@lesson.Description</p>
            </a>
        }
    </div>
</section>

@* ===== 7. Practice modes ===== *@
<section class="na-home-compartment-v2" aria-labelledby="practice-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Train every skill</span>
        <h2 id="practice-title">Interactive practice <span>練習</span></h2>
        <p>Move beyond reading explanations with recognition, listening, recall and guided handwriting.</p>
    </div>
    <div class="na-home-feature-grid-v2">
        <a asp-controller="Practice" asp-action="Reading" class="na-home-feature-card-v2">
            <i class="bi bi-eye"></i>
            <h4>Recognition</h4>
            <p>Read kana and kanji accurately without relying on chart order.</p>
        </a>
        <a asp-controller="Practice" asp-action="Listening" class="na-home-feature-card-v2">
            <i class="bi bi-headphones"></i>
            <h4>Listening</h4>
            <p>Hear Japanese at learner and natural speeds, then identify what was said.</p>
        </a>
        <a asp-controller="Practice" asp-action="Speaking" class="na-home-feature-card-v2">
            <i class="bi bi-keyboard"></i>
            <h4>Active recall</h4>
            <p>Produce answers yourself instead of only choosing from visible options.</p>
        </a>
        <a asp-controller="Practice" asp-action="Writing" class="na-home-feature-card-v2">
            <i class="bi bi-pencil-square"></i>
            <h4>Handwriting</h4>
            <p>Trace a guide, hide it, write from memory and compare your balance.</p>
        </a>
    </div>
</section>

@* ===== 8. Knowledge checks ===== *@
@if (Model.FeaturedQuizzes.Any())
{
    <section class="na-home-compartment-v2" aria-labelledby="quizzes-title">
        <div class="na-section-heading-v2">
            <span class="na-kicker">Check your understanding</span>
            <h2 id="quizzes-title">Knowledge checks <span>テスト</span></h2>
            <p>Short quizzes provide immediate feedback; course finals unlock after stable mastery.</p>
        </div>
        <div class="na-home-card-grid-v2">
        @foreach (var quiz in Model.FeaturedQuizzes)
        {
            var quizHref = isLoggedIn
                ? Url.Action("Take", "Quizzes", new { id = quiz.Id })
                : Url.Page("/Account/Login", new { area = "Identity", returnUrl = $"/Quizzes/Take/{quiz.Id}" });
            <a href="@quizHref" class="na-home-content-card-v2">
                <span class="na-badge na-badge-@(quiz.Category?.Name?.ToLower())">@quiz.Category?.Name</span>
                <h4>@quiz.Title</h4>
                <div class="ja">@quiz.JapaneseTitle</div>
                <div class="d-flex gap-3 mt-auto">
                    <span class="small text-muted"><strong>@quiz.Questions.Count</strong> questions</span>
                    <span class="small text-muted"><strong>@quiz.TimeLimitMinutes</strong> min</span>
                    <span class="small text-muted"><strong>@quiz.PassingScore%</strong> pass</span>
                </div>
            </a>
        }
        </div>
    </section>
}

@* ===== 9. Discover & connect ===== *@
<section class="na-home-compartment-v2" aria-labelledby="discover-title">
    <div class="na-section-heading-v2">
        <span class="na-kicker">Language in context</span>
        <h2 id="discover-title">Discover and connect <span>日本を知る</span></h2>
        <p>Explore Japan's regions and learn with a community instead of studying in isolation.</p>
    </div>
    <div class="na-home-discovery-v2">
        <a asp-controller="ExploreJapan" asp-action="Index" class="na-home-discovery-card-v2 na-home-discovery-card-v2--map">
            <i class="bi bi-map"></i>
            <span>Interactive map</span>
            <strong>Explore all nine regions</strong>
        </a>
        @if (isLoggedIn)
        {
            <a asp-controller="Community" asp-action="Index" class="na-home-discovery-card-v2 na-home-discovery-card-v2--community">
                <i class="bi bi-people"></i>
                <span>Learner community</span>
                <strong>Discuss, ask and encourage</strong>
            </a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Community" class="na-home-discovery-card-v2 na-home-discovery-card-v2--community">
                <i class="bi bi-people"></i>
                <span>Learner community</span>
                <strong>Sign in to join discussions</strong>
            </a>
        }
    </div>
</section>

@* ===== 10. Final CTA ===== *@
@if (!isLoggedIn)
{
    <section class="na-cta-v2">
        <h3>Ready to start your journey?</h3>
        <p>Register for free to track your progress, save flashcards, and join the community.</p>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-na-primary btn-lg">
            <i class="bi bi-person-plus"></i> Create Free Account
        </a>
    </section>
}

@section Scripts {
    @if (isLoggedIn)
    {
        <script>
        (function() {
            var POLL_INTERVAL = 30000;

            function pollProgress() {
                fetch('/Home/GetProgressData', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.success) return;
                    updateProgressUI(data);
                })
                .catch(function() { /* silent */ });
            }

            function updateProgressUI(data) {
                if (data.continueLearning && data.continueLearning.length > 0) {
                    var first = data.continueLearning[0];
                    var bar = document.querySelector('.na-continue-card-v2 .na-progress-fill');
                    var pctText = document.querySelector('.na-continue-card-v2 [data-pct-text]');
                    if (bar && first.completionPercentage !== undefined) {
                        bar.style.width = first.completionPercentage + '%';
                    }
                    if (pctText && first.completionPercentage !== undefined) {
                        pctText.innerHTML = '<i class="bi bi-bar-chart"></i> ' + first.completionPercentage + '% complete';
                    }
                }
            }

            setInterval(pollProgress, POLL_INTERVAL);
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) pollProgress();
            });
        })();
        </script>
    }
}
