@section Scripts {
    <script>
    (function() {
        var onboarding = document.getElementById('naOnboarding');
        if (!onboarding) return;

        var panels = onboarding.querySelectorAll('.na-onboarding-panel');
        var steps = onboarding.querySelectorAll('.na-onboarding-step');
        var actions = onboarding.querySelectorAll('[data-action]');
        if (!panels.length) return;

        var current = 1;
        var answers = { goal: null, level: null, age: null };

        function goTo(step) {
            current = Math.max(1, Math.min(panels.length, step));
            panels.forEach(function(p) {
                p.classList.toggle('is-active', parseInt(p.dataset.panel, 10) === current);
            });
            steps.forEach(function(s) {
                var sn = parseInt(s.dataset.step, 10);
                s.classList.toggle('is-active', sn === current);
                s.classList.toggle('is-done', sn < current);
            });

            if (current === panels.length) {
                fillResult();
            }
        }

        function fillResult() {
            Object.keys(answers).forEach(function(key) {
                var el = onboarding.querySelector('[data-result="' + key + '"]');
                if (el) el.textContent = answers[key] || '—';
            });
        }

        function nextButtonFor(panel) {
            var next = null;
            panel.querySelectorAll('[data-action]').forEach(function(b) {
                if (b.dataset.action === 'next') next = b;
            });
            return next;
        }

        function syncNextState() {
            var panel = onboarding.querySelector('.na-onboarding-panel.is-active');
            if (!panel) return;
            var input = panel.querySelector('input[type="radio"]:checked');
            var nextBtn = nextButtonFor(panel);
            if (nextBtn && nextBtn.disabled) {
                nextBtn.disabled = !input;
            }
        }

        actions.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var act = btn.dataset.action;
                if (act === 'next') {
                    var panel = btn.closest('.na-onboarding-panel');
                    if (panel) {
                        var checked = panel.querySelector('input[type="radio"]:checked');
                        if (checked) {
                            var name = checked.name;
                            answers[name] = checked.value;
                        }
                    }
                    goTo(current + 1);
                } else if (act === 'prev') {
                    goTo(current - 1);
                } else if (act === 'restart') {
                    answers = { goal: null, level: null, age: null };
                    onboarding.querySelectorAll('input[type="radio"]').forEach(function(r) { r.checked = false; });
                    goTo(1);
                }
            });
        });

        onboarding.querySelectorAll('.na-onboarding-option').forEach(function(label) {
            label.addEventListener('click', function(e) {
                var input = label.querySelector('input[type="radio"]');
                if (input) {
                    input.checked = true;
                    label.classList.add('is-selected');
                    // De-select siblings
                    var group = input.name;
                    onboarding.querySelectorAll('input[name="' + group + '"]').forEach(function(other) {
                        if (other !== input) {
                            other.parentElement.classList.remove('is-selected');
                        }
                    });
                    setTimeout(syncNextState, 0);
                }
            });
        });

        goTo(1);
    })();
    </script>
    <script>
    (function() {
        var banner = document.getElementById('naHeroBanner');
        if (!banner) return;
        var track = banner.querySelector('.na-hero-banner-track');
        var slides = banner.querySelectorAll('.na-hero-slide');
        var dots = document.querySelectorAll('.na-hero-banner-dot');
        var prev = banner.querySelector('.na-hero-banner-arrow--prev');
        var next = banner.querySelector('.na-hero-banner-arrow--next');

        if (!track || slides.length === 0) return;

        var current = 0;
        var total = slides.length;
        var autoTimer = null;
        var INTERVAL = 6000;

        function goTo(idx) {
            current = (idx + total) % total;
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            slides.forEach(function(s, i) {
                s.classList.toggle('is-active', i === current);
            });
            dots.forEach(function(d, i) {
                d.classList.toggle('is-active', i === current);
                d.setAttribute('aria-selected', i === current ? 'true' : 'false');
            });
        }

        function startAuto() {
            stopAuto();
            autoTimer = setInterval(function() { goTo(current + 1); }, INTERVAL);
        }

        function stopAuto() {
            if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
        }

        if (prev) prev.addEventListener('click', function() { goTo(current - 1); startAuto(); });
        if (next) next.addEventListener('click', function() { goTo(current + 1); startAuto(); });

        dots.forEach(function(d, i) {
            d.addEventListener('click', function() { goTo(i); startAuto(); });
        });

        // Pause on hover
        banner.addEventListener('mouseenter', stopAuto);
        banner.addEventListener('mouseleave', startAuto);

        // Touch swipe support
        var startX = 0, startY = 0, dx = 0, isTouch = false;
        banner.addEventListener('touchstart', function(e) {
            if (!e.touches.length) return;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            dx = 0;
            isTouch = true;
            stopAuto();
        }, { passive: true });

        banner.addEventListener('touchmove', function(e) {
            if (!isTouch || !e.touches.length) return;
            dx = e.touches[0].clientX - startX;
        }, { passive: true });

        banner.addEventListener('touchend', function() {
            if (!isTouch) return;
            isTouch = false;
            if (Math.abs(dx) > 50) {
                goTo(dx < 0 ? current + 1 : current - 1);
            }
            startAuto();
        });

        // Keyboard navigation
        banner.setAttribute('tabindex', '0');
        banner.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft')  { goTo(current - 1); startAuto(); }
            if (e.key === 'ArrowRight') { goTo(current + 1); startAuto(); }
        });

        startAuto();
    })();
    </script>
    @if (isLoggedIn)
    {
    <script>
    (function() {
        var POLL_INTERVAL = 30000;
        var lastData = null;

        function pollProgress() {
            fetch('/Home/GetProgressData', {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
                credentials: 'same-origin'
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) return;
                lastData = data;
                updateProgressUI(data);
            })
            .catch(function() { /* silent */ });
        }

        function updateProgressUI(data) {
            // Update Continue Learning cards
            var section = document.getElementById('continue-learning-section');
            if (!section) return;
            var cardsContainer = document.getElementById('continue-learning-cards');
            if (!cardsContainer) return;

            if (data.continueLearning && data.continueLearning.length > 0) {
                var titleEl = section.querySelector('.na-section-title');
                if (titleEl) {
                    titleEl.innerHTML = '<i class="bi bi-play-circle na-page-icon"></i> Continue Learning <span class="na-subtitle-jp">学習を続ける</span>';
                }
                var html = '';
                for (var i = 0; i < data.continueLearning.length; i++) {
                    var cl = data.continueLearning[i];
                    var pct = cl.completionPercentage;
                    var actionLabel = pct === 0 ? 'Start Lesson' : 'Continue';
                    var actionIcon = pct === 0 ? 'bi-play-fill' : 'bi-arrow-right';
                    var remaining = cl.estimatedMinutes > 0 ? Math.max(1, Math.ceil(cl.estimatedMinutes * (100 - pct) / 100)) : 0;
                    html += '<a href="/Lessons/Details/' + cl.lessonId + '" class="text-decoration-none mb-2 d-block" data-lesson-card="' + cl.lessonId + '">';
                    html += '<div class="na-continue-card-h">';
                    html += '  <div class="na-continue-card-h-body">';
                    html += '    <div class="d-flex align-items-center gap-2 mb-1">';
                    html += '      <span class="na-badge">' + escHtml(cl.category) + '</span>';
                    html += '      <span class="na-continue-percent">' + pct + '%</span>';
                    html += '    </div>';
                    html += '    <h5 class="text-dark mb-1">' + escHtml(cl.title) + '</h5>';
                    if (cl.japaneseTitle) html += '    <p class="text-na-primary small mb-1">' + escHtml(cl.japaneseTitle) + '</p>';
                    html += '    <div class="d-flex align-items-center gap-3 text-muted small">';
                    html += '      <span><i class="bi bi-bar-chart"></i> ' + pct + '% complete</span>';
                    if (remaining > 0) html += '      <span><i class="bi bi-clock"></i> ~' + remaining + ' min left</span>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '  <div class="na-continue-card-h-action">';
                    html += '    <span class="btn-na-primary btn-sm"><i class="' + actionIcon + '"></i> ' + actionLabel + '</span>';
                    html += '  </div>';
                    html += '  <div class="na-continue-card-h-progress">';
                    html += '    <div class="na-progress na-progress--inline">';
                    html += '      <div class="na-progress-fill" style="width: ' + pct + '%"></div>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '</div>';
                    html += '</a>';
                }
                cardsContainer.innerHTML = html;
            }
            else if (data.nextLessons && data.nextLessons.length > 0) {
                var titleEl = section.querySelector('.na-section-title');
                if (titleEl) {
                    titleEl.innerHTML = '<i class="bi bi-lightbulb na-page-icon"></i> Start Your Next Lesson <span class="na-subtitle-jp">次のレッスン</span>';
                }
                var html = '';
                for (var i = 0; i < data.nextLessons.length; i++) {
                    var nl = data.nextLessons[i];
                    html += '<a href="/Lessons/Details/' + nl.lessonId + '" class="text-decoration-none mb-2 d-block" data-lesson-card="' + nl.lessonId + '">';
                    html += '<div class="na-continue-card-h">';
                    html += '  <div class="na-continue-card-h-body">';
                    html += '    <div class="d-flex align-items-center gap-2 mb-1">';
                    html += '      <span class="na-badge">' + escHtml(nl.category) + '</span>';
                    html += '    </div>';
                    html += '    <h5 class="text-dark mb-1">' + escHtml(nl.title) + '</h5>';
                    if (nl.japaneseTitle) html += '    <p class="text-na-primary small mb-1">' + escHtml(nl.japaneseTitle) + '</p>';
                    html += '    <div class="d-flex align-items-center gap-3 text-muted small">';
                    html += '      <span><i class="bi bi-clock"></i> ' + nl.estimatedMinutes + ' min</span>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '  <div class="na-continue-card-h-action">';
                    html += '    <span class="btn-na-primary btn-sm"><i class="bi bi-play-fill"></i> Start Lesson</span>';
                    html += '  </div>';
                    html += '</div>';
                    html += '</a>';
                }
                cardsContainer.innerHTML = html;
            }
        }

        function escHtml(str) {
            var div = document.createElement('div');
            div.textContent = str || '';
            return div.innerHTML;
        }

        setInterval(pollProgress, POLL_INTERVAL);
        document.addEventListener('visibilitychange', function() {
            if (!document.hidden) pollProgress();
        });
    })();
    </script>
    }
}
