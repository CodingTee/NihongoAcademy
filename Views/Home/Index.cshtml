@model NihongoAcademy.Controllers.HomeViewModel

@{
    ViewData["Title"] = "Home";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var hasContinueLearning = isLoggedIn && Model.ContinueLearning.Any();
    var hasNextLessons = isLoggedIn && !Model.ContinueLearning.Any() && Model.NextLessons.Any();
}

@* ===== 1. Hero Banner Slider ===== *@
<section class="na-hero-banner" aria-label="Featured highlights">
    <div class="na-hero-banner-viewport" id="naHeroBanner">
        <div class="na-hero-banner-track">

            @* ---- Slide 1: Learn Japanese ---- *@
            <article class="na-hero-slide na-hero-slide--learn is-active" aria-roledescription="slide" aria-label="1 of 3">
                <div class="na-hero-slide-bg na-hero-slide-bg--learn">
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--1"></div>
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--2"></div>
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--3"></div>
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--4"></div>
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--5"></div>
                    <div class="na-hero-slide-bg-petal na-hero-slide-bg-petal--6"></div>
                    <div class="na-hero-slide-bg-glyph na-hero-slide-bg-glyph--a">学</div>
                    <div class="na-hero-slide-bg-glyph na-hero-slide-bg-glyph--b">語</div>
                    <div class="na-hero-slide-bg-glyph na-hero-slide-bg-glyph--c">あ</div>
                </div>
                <div class="na-hero-slide-inner">
                    <div class="na-hero-slide-text">
                        <span class="na-hero-slide-eyebrow">
                            <i class="bi bi-stars"></i> Welcome to Nihongo Academy
                        </span>
                        <h1 class="na-hero-slide-title">
                            Learn Japanese<br />with Confidence
                        </h1>
                        <p class="na-hero-slide-title-ja">日本語を楽しく学ぼう</p>
                        <p class="na-hero-slide-lead">
                            Master hiragana, katakana, vocabulary, and grammar through interactive lessons.
                        </p>
                        <div class="na-hero-slide-cta">
                            @if (!isLoggedIn)
                            {
                                <a asp-area="Identity" asp-page="/Account/Register" class="btn-na-primary btn-lg">
                                    <i class="bi bi-person-plus"></i> Start Learning
                                </a>
                                <a asp-controller="Lessons" asp-action="Index" class="btn-na-outline btn-lg">
                                    <i class="bi bi-journal-text"></i> Explore Lessons
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Lessons" asp-action="Index" class="btn-na-primary btn-lg">
                                    <i class="bi bi-journal-text"></i> Browse Lessons
                                </a>
                                <a asp-controller="Practice" asp-action="Index" class="btn-na-outline btn-lg">
                                    <i class="bi bi-pencil-square"></i> Practice Now
                                </a>
                            }
                        </div>
                    </div>
                    <div class="na-hero-slide-art">
                        <div class="na-hero-slide-mascot-frame">
                            <img src="~/images/Pet/Aegithalos caudatus.gif" alt="Long-tailed tit mascot" class="na-hero-slide-mascot" />
                        </div>
                    </div>
                </div>
            </article>

            @* ---- Slide 2: Master the Scripts ---- *@
            <article class="na-hero-slide na-hero-slide--scripts" aria-roledescription="slide" aria-label="2 of 3">
                <div class="na-hero-slide-bg na-hero-slide-bg--scripts">
                    <div class="na-hero-slide-bg-char na-hero-slide-bg-char--a">あ</div>
                    <div class="na-hero-slide-bg-char na-hero-slide-bg-char--b">ア</div>
                    <div class="na-hero-slide-bg-char na-hero-slide-bg-char--c">日</div>
                    <div class="na-hero-slide-bg-char na-hero-slide-bg-char--d">か</div>
                    <div class="na-hero-slide-bg-char na-hero-slide-bg-char--e">カ</div>
                    <div class="na-hero-slide-bg-grid"></div>
                </div>
                <div class="na-hero-slide-inner">
                    <div class="na-hero-slide-text">
                        <span class="na-hero-slide-eyebrow">
                            <i class="bi bi-pencil"></i> The Three Scripts
                        </span>
                        <h1 class="na-hero-slide-title">
                            Master Hiragana,<br />Katakana &amp; Kanji
                        </h1>
                        <p class="na-hero-slide-title-ja">ひらがな・カタカナ・漢字</p>
                        <p class="na-hero-slide-lead">
                            Step-by-step lessons, stroke-order diagrams, and smart drills take you from your first あ to fluent reading.
                        </p>
                        <div class="na-hero-slide-cta">
                            <a asp-controller="Lessons" asp-action="Index" class="btn-na-primary btn-lg">
                                <i class="bi bi-book"></i> Browse Lessons
                            </a>
                            <a asp-controller="Practice" asp-action="Index" class="btn-na-outline btn-lg">
                                <i class="bi bi-controller"></i> Start Drills
                            </a>
                        </div>
                    </div>
                    <div class="na-hero-slide-art">
                        <div class="na-hero-script-card">
                            <div class="na-hero-script-card-row"><span class="na-hero-script-hira">あ</span><span class="na-hero-script-kata">ア</span><span class="na-hero-script-kanji">日</span></div>
                            <div class="na-hero-script-card-row"><span class="na-hero-script-hira">か</span><span class="na-hero-script-kata">カ</span><span class="na-hero-script-kanji">語</span></div>
                            <div class="na-hero-script-card-row"><span class="na-hero-script-hira">さ</span><span class="na-hero-script-kata">サ</span><span class="na-hero-script-kanji">学</span></div>
                            <div class="na-hero-script-card-row"><span class="na-hero-script-hira">な</span><span class="na-hero-script-kata">ナ</span><span class="na-hero-script-kanji">本</span></div>
                        </div>
                    </div>
                </div>
            </article>

            @* ---- Slide 3: Discover Japan ---- *@
            <article class="na-hero-slide na-hero-slide--japan" aria-roledescription="slide" aria-label="3 of 3">
                <div class="na-hero-slide-bg na-hero-slide-bg--japan"></div>
                <div class="na-hero-slide-inner">
                    <div class="na-hero-slide-text">
                        <span class="na-hero-slide-eyebrow">
                            <i class="bi bi-geo-alt"></i> Interactive Japan Map
                        </span>
                        <h1 class="na-hero-slide-title">
                            Discover Japan's<br />Nine Regions
                        </h1>
                        <p class="na-hero-slide-lead">
                            From snow-covered Hokkaidō in the north to the subtropical Ryūkyū islands in the south — tap any red dot to dive into a region's story.
                        </p>
                        <div class="na-hero-slide-cta">
                            <a asp-controller="ExploreJapan" asp-action="Regions" class="btn-na-primary btn-lg">
                                <i class="bi bi-map"></i> Explore All Regions
                            </a>
                            <a asp-controller="ExploreJapan" asp-action="Index" class="btn-na-outline btn-lg">
                                <i class="bi bi-arrow-right-circle"></i> Open Map
                            </a>
                        </div>
                    </div>
                    <div class="na-hero-slide-art">
                        <div class="na-hero-japan-card">
                            <img src="/images/Japan%20Region/Japan.png" alt="Map of Japan" class="na-hero-japan-card-map" />
                            <div class="na-hero-japan-card-markers">
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="hokkaido" style="top:17%; left:75%;" title="Hokkaidō"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">北海道</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="tohoku"   style="top:30%; left:67%;" title="Tōhoku"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">東北</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="kanto"    style="top:50%; left:63%;" title="Kantō"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">関東</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="chubu"    style="top:53%; left:52%;" title="Chūbu"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">中部</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="kansai"   style="top:60%; left:43%;" title="Kansai"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">関西</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="chugoku"  style="top:65%; left:30%;" title="Chūgoku"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">中国</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="shikoku"  style="top:73%; left:35%;" title="Shikoku"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">四国</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="kyushu"   style="top:75%; left:22%;" title="Kyūshū"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">九州</span></a>
                                <a class="na-hero-japan-card-marker" asp-controller="ExploreJapan" asp-action="RegionDetail" asp-route-slug="okinawa"  style="top:87%; left:18%;" title="Okinawa"><span class="na-hero-japan-card-marker-dot"></span><span class="na-hero-japan-card-marker-label">沖縄</span></a>
                            </div>
                        </div>
                    </div>
                </div>
            </article>

        </div>

        @* Prev / Next controls *@
        <button type="button" class="na-hero-banner-arrow na-hero-banner-arrow--prev" aria-label="Previous slide">
            <i class="bi bi-chevron-left"></i>
        </button>
        <button type="button" class="na-hero-banner-arrow na-hero-banner-arrow--next" aria-label="Next slide">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    @* Dots indicator *@
    <div class="na-hero-banner-dots" role="tablist" aria-label="Slide selector">
        <button type="button" class="na-hero-banner-dot is-active" role="tab" aria-selected="true" aria-label="Slide 1"></button>
        <button type="button" class="na-hero-banner-dot" role="tab" aria-selected="false" aria-label="Slide 2"></button>
        <button type="button" class="na-hero-banner-dot" role="tab" aria-selected="false" aria-label="Slide 3"></button>
    </div>
</section>

@* ===== 2. Mini Motivation Strip (logged in only) ===== *@
@if (isLoggedIn)
{
    <section class="na-section na-section--tight mt-3">
        <div class="na-motivation-strip">
            <a asp-controller="Dashboard" asp-action="Index" class="na-motivation-item na-motivation-item--streak text-decoration-none">
                <i class="bi bi-fire"></i>
                <span><strong>@Model.UserStreak</strong> Day Streak</span>
            </a>
            <div class="na-motivation-item na-motivation-item--goal">
                <i class="bi bi-bullseye"></i>
                <span>Today's Goal: <strong>@Model.DailyProgress/@Model.DailyGoal</strong></span>
            </div>
            @if (hasContinueLearning && Model.ContinueLearning.First().Lesson != null)
            {
                <div class="na-motivation-item na-motivation-item--next">
                    <i class="bi bi-arrow-right-circle"></i>
                    <span>Next: @Model.ContinueLearning.First().Lesson?.Title</span>
                </div>
            }
        </div>
    </section>
}

@* ===== 3. Continue Learning / Start Next Lesson ===== *@
@if (hasContinueLearning)
{
    <section id="continue-learning-section" class="na-section na-section--tight mt-3">
        <h3 class="na-section-title">
            <i class="bi bi-play-circle na-page-icon"></i> Continue Learning
            <span class="na-subtitle-jp">学習を続ける</span>
        </h3>
        <div id="continue-learning-cards">
        @foreach (var progress in Model.ContinueLearning)
        {
            var actionLabel = progress.CompletionPercentage == 0 ? "Start Lesson" : "Continue";
            var actionIcon = progress.CompletionPercentage == 0 ? "bi-play-fill" : "bi-arrow-right";
            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@progress.LessonId" class="text-decoration-none mb-2 d-block" data-lesson-card="@progress.LessonId">
                <div class="na-continue-card-h">
                    <div class="na-continue-card-h-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="na-badge na-badge-@(progress.Lesson?.Category?.Name?.ToLower())">
                                @progress.Lesson?.Category?.Name
                            </span>
                            <span class="na-continue-percent" data-pct-label="@progress.LessonId">@progress.CompletionPercentage%</span>
                        </div>
                        <h5 class="text-dark mb-1">@progress.Lesson?.Title</h5>
                        @if (!string.IsNullOrEmpty(progress.Lesson?.JapaneseTitle))
                        {
                            <p class="text-na-primary small mb-1">@progress.Lesson.JapaneseTitle</p>
                        }
                        <div class="d-flex align-items-center gap-3 text-muted small">
                            <span data-pct-text="@progress.LessonId"><i class="bi bi-bar-chart"></i> @progress.CompletionPercentage% complete</span>
                            @if (progress.Lesson?.EstimatedMinutes > 0)
                            {
                                var remaining = Math.Max(1, (int)Math.Ceiling(progress.Lesson.EstimatedMinutes * (100 - progress.CompletionPercentage) / 100.0));
                                <span data-remaining="@progress.LessonId"><i class="bi bi-clock"></i> ~@remaining min left</span>
                            }
                        </div>
                    </div>
                    <div class="na-continue-card-h-action" data-action="@progress.LessonId">
                        <span class="btn-na-primary btn-sm"><i class="@actionIcon"></i> @actionLabel</span>
                    </div>
                    <div class="na-continue-card-h-progress">
                        <div class="na-progress na-progress--inline">
                            <div class="na-progress-fill" data-progress-bar="@progress.LessonId" style="width: @progress.CompletionPercentage%"></div>
                        </div>
                    </div>
                </div>
            </a>
        }
        </div>
    </section>
}
else if (hasNextLessons)
{
    <section id="continue-learning-section" class="na-section na-section--tight mt-3">
        <h3 class="na-section-title">
            <i class="bi bi-lightbulb na-page-icon"></i> Start Your Next Lesson
            <span class="na-subtitle-jp">次のレッスン</span>
        </h3>
        <div id="continue-learning-cards">
        @foreach (var lesson in Model.NextLessons)
        {
            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.Id" class="text-decoration-none mb-2 d-block" data-lesson-card="@lesson.Id">
                <div class="na-continue-card-h">
                    <div class="na-continue-card-h-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="na-badge na-badge-@(lesson.Category?.Name?.ToLower())">
                                @lesson.Category?.Name
                            </span>
                        </div>
                        <h5 class="text-dark mb-1">@lesson.Title</h5>
                        @if (!string.IsNullOrEmpty(lesson.JapaneseTitle))
                        {
                            <p class="text-na-primary small mb-1">@lesson.JapaneseTitle</p>
                        }
                        <div class="d-flex align-items-center gap-3 text-muted small">
                            <span><i class="bi bi-clock"></i> @lesson.EstimatedMinutes min</span>
                        </div>
                    </div>
                    <div class="na-continue-card-h-action">
                        <span class="btn-na-primary btn-sm"><i class="bi bi-play-fill"></i> Start Lesson</span>
                    </div>
                </div>
            </a>
        }
        </div>
    </section>
}

@* ===== 4. Quick Action Shortcuts ===== *@
@if (isLoggedIn)
{
    <section class="na-section na-section--tight mt-3">
        <h3 class="na-section-title">
            <i class="bi bi-grid na-page-icon"></i> What would you like to do?
            <span class="na-subtitle-jp">何をする？</span>
