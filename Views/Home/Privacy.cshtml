@{
    ViewData["Title"] = "Privacy";
}

<h2><i class="bi bi-shield"></i> Privacy Policy</h2>

<div class="na-card-flat">
    <h4>Information We Collect</h4>
    <p>NihongoAcademy collects your email address and password for account authentication. Your quiz results and lesson progress are stored to provide personalized learning experiences.</p>

    <h4 class="mt-3">How We Use Your Information</h4>
    <ul>
        <li>To authenticate your account and provide secure access</li>
        <li>To track your learning progress and quiz performance</li>
        <li>To display personalized dashboard analytics</li>
    </ul>

    <h4 class="mt-3">Data Security</h4>
    <p>Your password is securely hashed using ASP.NET Identity. We use HTTPS encryption for all data transmission.</p>

    <h4 class="mt-3">Your Rights</h4>
    <p>You can request deletion of your account and associated data at any time by contacting the administrator.</p>

    <h4 class="mt-3">Contact</h4>
    <p>For privacy inquiries, contact: admin@nihongoacademy.com</p>
</div>
