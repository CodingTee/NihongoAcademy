@{
    ViewData["Title"] = "About";
}

<div class="na-hero">
    <h1>About NihongoAcademy</h1>
    <p class="jp-subtitle">日本語学院について</p>
</div>

<div class="row mt-5">
    <div class="col-md-8">
        <div class="na-card">
            <h3><i class="bi bi-bullseye"></i> Our Mission</h3>
            <p>NihongoAcademy is a web-based learning platform designed to help beginners master the Japanese language. We provide interactive lessons, flashcards, and quizzes that make learning Japanese engaging and effective.</p>

            <h3 class="mt-4"><i class="bi bi-lightbulb"></i> What We Offer</h3>
            <ul>
                <li><strong>Structured Lessons:</strong> Learn hiragana, katakana, vocabulary, grammar, and kanji through carefully structured lessons.</li>
                <li><strong>Interactive Flashcards:</strong> Practice with 3D flip flashcards featuring Japanese text, romaji, and English meanings.</li>
                <li><strong>Timed Quizzes:</strong> Test your knowledge with quizzes that provide instant feedback and detailed explanations.</li>
                <li><strong>Progress Tracking:</strong> Monitor your learning journey with visual progress charts and completion statistics.</li>
                <li><strong>Audio Pronunciation:</strong> Listen to correct pronunciation for vocabulary words (coming soon).</li>
            </ul>

            <h3 class="mt-4"><i class="bi bi-people"></i> Who Is This For?</h3>
            <p>This platform is designed for:</p>
            <ul>
                <li>Beginners starting their Japanese learning journey (JLPT N5 level)</li>
                <li>Students preparing for the JLPT (Japanese Language Proficiency Test)</li>
                <li>Anyone interested in Japanese language and culture</li>
                <li>Self-learners who want a structured approach to studying Japanese</li>
            </ul>

            <h3 class="mt-4"><i class="bi bi-code-slash"></i> Technology</h3>
            <p>Built with ASP.NET Core MVC, Entity Framework Core, SQL Server, and modern web technologies including Bootstrap 5, Chart.js, and CSS3 animations.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="na-card text-center">
            <h4>Quick Stats</h4>
            <hr />
            <div class="na-stat mb-3">
                <div class="stat-number">6</div>
                <div class="stat-label">Categories</div>
            </div>
            <div class="na-stat mb-3">
                <div class="stat-number">JLPT N5</div>
                <div class="stat-label">Level Coverage</div>
            </div>
            <div class="na-stat mb-3">
                <div class="stat-number">3</div>
                <div class="stat-label">User Roles</div>
            </div>
            <div class="na-stat">
                <div class="stat-number">100%</div>
                <div class="stat-label">Free</div>
            </div>
        </div>

        <div class="na-card mt-3" style="background: var(--na-sakura-light);">
            <h5><i class="bi bi-heart"></i> 楽しく学ぼう</h5>
            <p class="mb-0 small text-muted">"Learn with joy" — our guiding principle at NihongoAcademy.</p>
        </div>
    </div>
</div>
