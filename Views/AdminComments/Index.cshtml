@model List<NihongoAcademy.Models.CommunityComment>
@using NihongoAcademy.Models
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Comment Moderation";
    var search = (string?)ViewBag.Search;
    var status = (string?)ViewBag.Status ?? "active";
    var total = (int)ViewBag.TotalCount;
    var taken = (int)ViewBag.TakenCount;
    var active = (int)ViewBag.ActiveCount;
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Comment Moderation" }
    },
    Icon = "bi-chat-left-text",
    Title = "Comment Moderation",
    TitleJp = "コメント管理",
    Lead = "Browse and moderate community comments directly. Taken-down comments are hidden from the thread until restored.",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Content Reports", Url = Url.Action("Index", "AdminModeration"), Icon = "bi-flag", Outline = true }
    }
})

<div class="na-card-flat mb-4">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Search content or author</label>
            <input type="text" name="search" value="@search" class="form-control na-input" placeholder="Type to filter…" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select na-input" onchange="this.form.submit()">
                <option value="active" selected="@(status == "active")">Active (@active)</option>
                <option value="taken" selected="@(status == "taken")">Taken down (@taken)</option>
                <option value="all" selected="@(status == "all")">All (@total)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-na-outline"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-na-outline">Reset</a>
        </div>
    </form>
</div>

<div class="na-card-flat">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">No comments match this filter.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Comment</th>
                        <th>Author</th>
                        <th>On post</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="@(c.IsTakenDown ? "na-row-muted" : "")">
                            <td style="max-width:340px;">
                                <div class="text-truncate" title="@c.Content">@(c.Content.Length > 140 ? c.Content.Substring(0, 140) + "…" : c.Content)</div>
                                @if (c.ParentCommentId.HasValue)
                                {
                                    <span class="na-badge bg-light text-muted small">reply</span>
                                }
                                @if (c.IsTakenDown && !string.IsNullOrEmpty(c.TakenDownReason))
                                {
                                    <div class="small text-danger mt-1">Reason: @c.TakenDownReason</div>
                                }
                            </td>
                            <td class="text-nowrap">
                                <span class="na-badge bg-light text-muted">@(c.User?.Email ?? c.UserId)</span>
                            </td>
                            <td class="text-nowrap">
                                @if (c.Post != null)
                                {
                                    <a href="/Community/Details/@c.PostId" class="text-decoration-none" target="_blank" title="@c.Post.Title">
                                        <i class="bi bi-box-arrow-up-right"></i> @(c.Post.Title.Length > 28 ? c.Post.Title.Substring(0, 28) + "…" : c.Post.Title)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-nowrap small text-muted">@c.CreatedDate.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            <td>
                                @if (c.IsTakenDown)
                                {
                                    <span class="na-badge bg-danger text-white"><i class="bi bi-eye-slash"></i> Hidden</span>
                                }
                                else
                                {
                                    <span class="na-badge bg-success text-white">Visible</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (c.IsTakenDown)
                                {
                                    <form asp-action="Restore" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="na-icon-btn" title="Restore"><i class="bi bi-arrow-counterclockwise"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="na-icon-btn" title="Take down"
                                            onclick="naTakedown(@c.Id)"><i class="bi bi-eye-slash"></i></button>
                                }
                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="na-icon-btn na-icon-danger" title="Delete permanently"
                                            onclick="return confirm('Permanently delete this comment and its replies?')"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="naTakedownModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content na-modal">
            <form id="naTakedownForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title"><i class="bi bi-eye-slash"></i> Take down comment</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason (sent to the author)</label>
                    <textarea name="reason" rows="3" class="form-control na-input" placeholder="Why is this comment being taken down?"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-na-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-na-primary">Take down</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function naTakedown(id) {
            var form = document.getElementById('naTakedownForm');
            form.action = '/AdminComments/TakeDown/' + id;
            var modal = new bootstrap.Modal(document.getElementById('naTakedownModal'));
            modal.show();
        }
    </script>
}
