@model NihongoAcademy.Services.ProgressSummary
@inject NihongoAcademy.Services.AchievementService AchievementService
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager
@{
    ViewData["Title"] = "Progress";
    var currentUserId = UserManager.GetUserId(User) ?? "";
    var badges = await AchievementService.GetUserBadgesAsync(currentUserId);
    var completionPct = Model.TotalLessons > 0 ? (Model.CompletedLessons * 100 / Model.TotalLessons) : 0;
    var masteryPct = Model.TotalLessons > 0 ? (Model.StableMasteredLessons * 100 / Model.TotalLessons) : 0;
    var activeDayIso = System.Text.Json.JsonSerializer.Serialize(Model.ActiveDays.Select(d => d.ToString("yyyy-MM-dd")));
    var quizLabels = System.Text.Json.JsonSerializer.Serialize(Model.RecentQuizLabels);
    var quizScores = System.Text.Json.JsonSerializer.Serialize(Model.RecentQuizScores);
    var radarLabels = System.Text.Json.JsonSerializer.Serialize(Model.SkillRadarScores.Keys.ToList());
    var radarValues = System.Text.Json.JsonSerializer.Serialize(Model.SkillRadarScores.Values.ToList());
}

<style>
.na-skillbars { display: flex; flex-direction: column; gap: .55rem; padding: .25rem 0; }
.na-skill-row { display: grid; grid-template-columns: 110px 1fr 44px; align-items: center; gap: .6rem; }
.na-skill-name { font-size: .85rem; font-weight: 600; color: #555; }
.na-skill-pct { font-size: .8rem; text-align: right; color: #888; }
.na-bars-row { display: flex; align-items: flex-end; gap: .5rem; width: 100%; height: 230px; padding-top: .5rem; }
.na-bar-col { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; flex: 1; height: 100%; gap: .35rem; }
.na-bar-track { width: 60%; max-width: 34px; flex: 1; background: rgba(238,150,164,.14); border-radius: 8px 8px 0 0; display: flex; align-items: flex-end; }
.na-bar-fill { width: 100%; background: linear-gradient(180deg,#ee96a4,#f6c0c9); border-radius: 8px 8px 0 0; transition: height .9s cubic-bezier(.22,1,.36,1); min-height: 3px; }
.na-bar-cap { font-size: .72rem; color: #888; }
</style>

<section class="na-page-hero-v2" aria-label="My Progress">
    <div class="na-hero-v2-deco" aria-hidden="true">
        <span class="na-hero-v2-glyph na-hero-v2-glyph--a">学</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--b">習</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--c">進</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--d">捗</span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
    </div>
    <div class="na-page-hero-v2-inner">
        <span class="na-page-hero-v2-eyebrow"><i class="bi bi-graph-up"></i> Learning cockpit</span>
        <h1 class="na-page-hero-v2-title">My Progress <span>進捗</span></h1>
        <p class="na-page-hero-v2-lead">See what matters now, then jump straight back into learning.</p>
    </div>
</section>

@if (Model.GoalPlan != null)
{
    <div class="na-card na-goal-plan-card mb-4" data-tour="tour-goal-plan" style="border-left: 5px solid @Model.GoalPlan.ThemeColor;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="na-goal-plan-icon" style="background: @(Model.GoalPlan.ThemeColor)20; color: @Model.GoalPlan.ThemeColor;">
                    <i class="bi @Model.GoalPlan.GoalIcon"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border">Your Personalized Plan</span>
                        <span class="text-muted small"><i class="bi bi-clock"></i> Pace: @Model.GoalPlan.RecommendedPace</span>
                    </div>
                    <h4 class="mb-1 mt-1">@Model.GoalPlan.GoalTitle</h4>
                    <p class="text-muted small mb-0">@Model.GoalPlan.Description</p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <div class="na-goal-focus-tag text-end d-none d-md-block me-2">
                    <small class="text-muted d-block">Current Focus</small>
                    <strong class="text-dark">@Model.GoalPlan.CurrentFocus</strong>
                </div>
                <a asp-controller="@Model.GoalPlan.RecommendedController" asp-action="@Model.GoalPlan.RecommendedAction" class="btn-na-primary btn-sm">
                    @Model.GoalPlan.RecommendedActionLabel <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        @if (Model.GoalPlan.Milestones.Any())
        {
            <div class="na-goal-milestones-row mt-3 pt-3 border-top">
                <span class="text-muted small fw-bold me-2"><i class="bi bi-check2-circle"></i> Key Milestones:</span>
                @foreach (var milestone in Model.GoalPlan.Milestones)
                {
                    <span class="na-milestone-chip">
                        <i class="bi bi-dot"></i> @milestone
                    </span>
                }
            </div>
        }
    </div>
}

<section class="na-progress-cockpit" aria-label="Today">
    <div class="na-progress-next-action" data-tour="tour-next-action">
        <span class="na-progress-kicker"><i class="bi @Model.NextAction.Icon"></i> @Model.NextAction.Label</span>
        <h2>@Model.NextAction.Title</h2>
        <p>@Model.NextAction.Description</p>
        @if (Model.NextAction.RouteId.HasValue)
        {
            <a class="btn-na-primary" asp-controller="@Model.NextAction.Controller" asp-action="@Model.NextAction.Action" asp-route-id="@Model.NextAction.RouteId">Continue <i class="bi bi-arrow-right"></i></a>
        }
        else
        {
            <a class="btn-na-primary" asp-controller="@Model.NextAction.Controller" asp-action="@Model.NextAction.Action">Start <i class="bi bi-arrow-right"></i></a>
        }
    </div>
    <div class="na-progress-metrics">
        <div class="dashboard-metric na-metric-animated" data-target="@Model.CurrentStreak">
            <div class="na-metric-icon"><i class="bi bi-fire"></i></div>
            <div class="metric-value" data-count="@Model.CurrentStreak">0</div>
            <div class="metric-label">Current streak</div>
            <small class="text-muted">Best @Model.LongestStreak days</small>
        </div>
        <div class="dashboard-metric na-metric-animated" data-target="@Model.DueReviewCount">
            <div class="na-metric-icon"><i class="bi bi-clock-history"></i></div>
            <div class="metric-value" data-count="@Model.DueReviewCount">0</div>
            <div class="metric-label">Review due</div>
            <small class="text-muted">@Model.AwaitingReviewCount waiting</small>
        </div>
        <div class="dashboard-metric na-metric-animated" data-target="@masteryPct">
            <div class="na-metric-icon"><i class="bi bi-trophy"></i></div>
            <div class="metric-value" data-count="@masteryPct">0<span class="na-metric-unit">%</span></div>
            <div class="metric-label">Overall mastery</div>
            <small class="text-muted">@Model.StableMasteredLessons / @Model.TotalLessons stable</small>
        </div>
        <div class="dashboard-metric na-metric-animated" data-target="@Model.AverageScore">
            <div class="na-metric-icon"><i class="bi bi-check-circle"></i></div>
            <div class="metric-value" data-count="@Model.AverageScore">0<span class="na-metric-unit">%</span></div>
            <div class="metric-label">Quiz average</div>
            <small class="text-success">@Model.PassedQuizzes / @Model.TotalQuizAttempts passed</small>
        </div>
    </div>
</section>

@* ===== Skill Radar + JLPT Milestones Row ===== *@
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="na-card-flat h-100" data-tour="tour-radar">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5><i class="bi bi-hexagon"></i> Skill Radar</h5>
                    <p class="text-muted small mb-0">Your strengths across five core Japanese skills.</p>
                </div>
                <span class="na-badge na-badge-glow">5 Skills</span>
            </div>
            <div class="na-radar-wrap">
                <div id="radarBars" class="na-skillbars" role="img" aria-label="Skill levels across five core Japanese skills"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="na-card-flat h-100" data-tour="tour-jlpt">
            <h5><i class="bi bi-flag"></i> JLPT Milestones</h5>
            <p class="text-muted small mb-2">Track your readiness towards official JLPT levels.</p>

            <div class="na-jlpt-card">
                <div class="na-jlpt-header">
                    <span class="na-jlpt-badge na-jlpt-n5">N5</span>
                    <span class="na-jlpt-title">JLPT N5 Readiness</span>
                    <span class="na-jlpt-pct">@Model.JlptN5Percentage%</span>
                </div>
                <div class="na-progress na-progress-lg">
                    <div class="na-progress-fill na-fill-n5 na-progress-animated" style="width: 0%;" data-width="@Model.JlptN5Percentage%"></div>
                </div>
                <small class="text-muted">@Model.CompletedLessons / 15 lessons completed toward N5</small>
            </div>

            <div class="na-jlpt-card">
                <div class="na-jlpt-header">
                    <span class="na-jlpt-badge na-jlpt-n4">N4</span>
                    <span class="na-jlpt-title">JLPT N4 Readiness</span>
                    <span class="na-jlpt-pct">@Model.JlptN4Percentage%</span>
                </div>
                <div class="na-progress na-progress-lg">
                    <div class="na-progress-fill na-fill-n4 na-progress-animated" style="width: 0%;" data-width="@Model.JlptN4Percentage%"></div>
                </div>
                <small class="text-muted">@Model.CompletedLessons / 30 lessons completed toward N4</small>
            </div>

            <div class="na-jlpt-card na-jlpt-locked">
                <div class="na-jlpt-header">
                    <span class="na-jlpt-badge na-jlpt-n3">N3</span>
                    <span class="na-jlpt-title">JLPT N3</span>
                    <span class="na-jlpt-pct"><i class="bi bi-lock"></i></span>
                </div>
                <div class="na-progress na-progress-lg">
                    <div class="na-progress-fill" style="width: 0%;"></div>
                </div>
                <small class="text-muted">Coming soon — complete N4 to unlock</small>
            </div>
        </div>
    </div>
</div>

@* ===== Learning Path Timeline + Study Rhythm Row ===== *@
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="na-card-flat h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <h5><i class="bi bi-map"></i> Learning Path Timeline</h5>
                    <p class="text-muted small mb-0">@completionPct% of published lessons completed.</p>
                </div>
                <a asp-controller="Lessons" asp-action="Index" class="btn-na-outline btn-sm">View lessons</a>
            </div>
            <div class="na-timeline">
                @foreach (var p in Model.LessonProgress.Take(12))
                {
                    var statusClass = p.StableMasteryDate.HasValue ? "is-mastered" : p.FirstMasteryPassedDate.HasValue ? "is-review" : "is-active";
                    var statusLabel = p.StableMasteryDate.HasValue ? "Mastered" : p.FirstMasteryPassedDate.HasValue ? "Review pending" : "In progress";
                    var statusIcon = p.StableMasteryDate.HasValue ? "bi-check-circle-fill" : p.FirstMasteryPassedDate.HasValue ? "bi-arrow-repeat" : "bi-play-circle";
                    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@p.LessonId" class="na-timeline-item @statusClass">
                        <span class="na-timeline-dot"><i class="bi @statusIcon"></i></span>
                        <span class="na-timeline-main"><strong>@p.Lesson?.Title</strong><small>@p.Lesson?.Category?.Name · @statusLabel</small></span>
                        <span class="na-timeline-progress">@p.CompletionPercentage%</span>
                    </a>
                }
                @if (!Model.LessonProgress.Any())
                {
                    <div class="text-center text-muted py-4">No lessons started yet. <a asp-controller="Lessons" asp-action="Index">Browse lessons</a></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="na-card-flat h-100">
            <h5><i class="bi bi-calendar-heart"></i> Study Rhythm</h5>
            <p class="text-muted small">A lightweight view of days with lesson or flashcard activity.</p>
            <div class="na-cal-toolbar">
                <button type="button" class="na-cal-arrow" id="naCalPrev" aria-label="Previous month"><i class="bi bi-chevron-left"></i></button>
                <span class="na-cal-month" id="naCalMonth" aria-live="polite"></span>
                <button type="button" class="na-cal-arrow" id="naCalNext" aria-label="Next month"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="na-cal-dow" aria-hidden="true"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
            <div class="na-cal-grid" id="naCalGrid" aria-label="Study calendar"></div>
            <div class="na-cal-legend mt-2">
                <span class="na-cal-legend-item"><span class="na-cal-legend-dot na-cal-legend-active"></span> Active day</span>
                <span class="na-cal-legend-item"><span class="na-cal-legend-dot na-cal-legend-today"></span> Today</span>
            </div>
        </div>
    </div>
</div>

@* ===== Quiz Trend + Category Progress Row ===== *@
<div class="row g-4">
    <div class="col-lg-7">
        <div class="na-card-flat h-100">
            <div class="d-flex justify-content-between gap-3 align-items-start mb-3">
                <div><h5><i class="bi bi-graph-up"></i> Quiz Trend</h5><p class="text-muted small mb-0">@Model.QuizInsight.Detail</p></div>
                <span class="na-badge">@Model.QuizInsight.Trend</span>
            </div>
            <div id="scoreBars" class="na-trendbars" role="img" aria-label="Quiz score trend over time" style="min-height: 260px;"></div>
            <div class="na-progress-insight mt-3"><i class="bi bi-lightbulb"></i><span>@Model.QuizInsight.Recommendation</span></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="na-card-flat h-100">
            <h5><i class="bi bi-bar-chart"></i> Category Progress</h5>
            <hr />
            @foreach (var cat in Model.CategoryProgress.Where(c => c.TotalLessons > 0))
            {
                var pct = cat.TotalLessons > 0 ? (cat.CompletedLessons * 100 / cat.TotalLessons) : 0;
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>@cat.CategoryName</span><small class="text-muted">@cat.CompletedLessons / @cat.TotalLessons</small></div>
                    <div class="na-progress"><div class="na-progress-fill" style="width: @pct%;"></div></div>
                </div>
            }
        </div>
    </div>
</div>

@* ===== Achievements & Badges Row ===== *@
@if (badges != null && badges.Any())
{
    <div class="na-card-flat mt-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="mb-0"><i class="bi bi-award text-warning"></i> Study Achievements</h5>
                <p class="text-muted small mb-0">Milestones unlocked along your Japanese learning path.</p>
            </div>
            <span class="badge bg-light text-dark border">
                @badges.Count(b => b.IsUnlocked) of @badges.Count Unlocked
            </span>
        </div>
        <div class="row g-3">
            @foreach (var badge in badges)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="na-badge-card p-3 rounded border h-100 d-flex align-items-center gap-3 @(badge.IsUnlocked ? "na-badge-unlocked" : "na-badge-locked")">
                        <div class="na-badge-card-icon" style="background: @(badge.IsUnlocked ? badge.Color + "20" : "#f1f2f6"); color: @(badge.IsUnlocked ? badge.Color : "#a4b0be");">
                            <i class="bi @badge.Icon"></i>
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="na-badge-card-title text-truncate d-block">@badge.Title</strong>
                                @if (badge.IsUnlocked)
                                {
                                    <i class="bi bi-check-circle-fill text-success small" title="Unlocked"></i>
                                }
                                else
                                {
                                    <i class="bi bi-lock-fill text-muted small" title="Locked"></i>
                                }
                            </div>
                            <small class="text-muted d-block na-badge-card-desc">@badge.Description</small>
                            <span class="na-badge-card-status small fw-bold" style="color: @(badge.IsUnlocked ? "#27ae60" : "#747d8c");">
                                @badge.ProgressText
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        window.naDashboardProgress = {
            activeDays: @Html.Raw(activeDayIso),
            quizLabels: @Html.Raw(quizLabels),
            quizScores: @Html.Raw(quizScores),
            radarLabels: @Html.Raw(radarLabels),
            radarValues: @Html.Raw(radarValues)
        };
    </script>
    <script src="~/js/dashboard-progress.js" asp-append-version="true"></script>
}
