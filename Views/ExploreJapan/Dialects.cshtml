@using NihongoAcademy.Models.ExploreJapan
@model List<ExploreItem>

@{
    ViewData["Title"] = "Dialects";
}

<nav class="na-explore-backbar mb-3">
    <a asp-controller="ExploreJapan" asp-action="Index" class="na-explore-back-link">
        <i class="bi bi-arrow-left"></i> Back to Interactive Japan Map
    </a>
</nav>

<div class="na-explore-detail-header">
    <h2>
        <i class="bi bi-chat-quote na-page-icon"></i>
        Dialects <span class="na-subtitle-jp">方言</span>
    </h2>
    <p class="text-muted">Six regional flavors of spoken Japanese — from Kansai theatre to Okinawan roots.</p>
</div>

<div class="na-explore-card-grid">
    @foreach (var item in Model)
    {
        @await Html.PartialAsync("_ExploreCard", item)
    }
</div>

