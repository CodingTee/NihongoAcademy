@{
    ViewData["Title"] = ViewBag.SkillTitle + " Practice";
    var vocab = ViewBag.Vocabulary as IEnumerable<NihongoAcademy.Models.Vocabulary>;
    var modeKey = ViewBag.ModeKey as string ?? "";
    var skillTitle = ViewBag.SkillTitle as string ?? "Practice";
    var skillJp = ViewBag.SkillJp as string ?? "練習";
    var skillIcon = ViewBag.SkillIcon as string ?? "🌸";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Practice</a></li>
        <li class="breadcrumb-item"><a asp-action="@skillTitle">@skillTitle</a></li>
        <li class="breadcrumb-item active">@modeKey</li>
    </ol>
</nav>

<div class="mb-4">
    <h2><span class="me-2">@skillIcon</span> @skillTitle <span class="na-subtitle-jp">@skillJp</span></h2>
</div>

<div class="na-card-flat p-4" id="practice-area">
    @switch (modeKey)
    {
        case "listen-choose":
            <div class="text-center mb-3">
                <h5>Listen & Choose</h5>
                <p class="text-muted">Listen to the audio and pick the correct answer.</p>
            </div>
            <div class="text-center mb-4">
                <button class="na-speak-btn" id="mode-play-btn" style="width:64px;height:64px;font-size:1.5rem;">
                    <i class="bi bi-volume-up-fill"></i>
                </button>
            </div>
            <div id="mode-question" class="text-center mb-3"></div>
            <div class="row g-2 justify-content-center" id="mode-options"></div>
            <div class="text-center mt-3">
                <button class="btn-na-primary btn-sm" id="mode-next-btn" style="display:none;">Next</button>
            </div>
            break;

        case "dictation":
            <div class="text-center mb-3">
                <h5>Dictation</h5>
                <p class="text-muted">Type what you hear.</p>
            </div>
            <div class="text-center mb-4">
                <button class="na-speak-btn" id="mode-play-btn" style="width:64px;height:64px;font-size:1.5rem;">
                    <i class="bi bi-volume-up-fill"></i>
                </button>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <input type="text" id="dictation-input" class="form-control form-control-lg text-center" placeholder="Type here..." autocomplete="off" />
                    <div class="text-center mt-3">
                        <button class="btn-na-primary" id="dictation-check">Check Answer</button>
                    </div>
                    <div id="dictation-feedback" class="mt-3" style="display:none;"></div>
                </div>
            </div>
            break;

        case "reading-comprehension":
            <div class="text-center mb-3">
                <h5>Reading Comprehension</h5>
                <p class="text-muted">Read the passage and answer the question.</p>
            </div>
            <div id="reading-passage" class="na-card-flat p-3 mb-3" style="background:var(--na-bg);">
                <p id="reading-text" class="mb-0" style="font-size:1.2rem;line-height:2;"></p>
            </div>
            <div id="reading-question" class="mb-3"></div>
            <div class="row g-2 justify-content-center" id="mode-options"></div>
            <div class="text-center mt-3">
                <button class="btn-na-primary btn-sm" id="mode-next-btn" style="display:none;">Next</button>
            </div>
            break;

        case "sentence-writing":
            <div class="text-center mb-3">
                <h5>Sentence Writing</h5>
                <p class="text-muted">Translate into Japanese.</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="na-card-flat p-3 mb-3" style="background:var(--na-bg);">
                        <p id="writing-prompt" class="mb-0 text-center" style="font-size:1.1rem;"></p>
                    </div>
                    <textarea id="writing-input" class="form-control" rows="3" placeholder="Write your answer in Japanese..."></textarea>
                    <div class="text-center mt-3">
                        <button class="btn-na-primary" id="writing-check">Check Answer</button>
                    </div>
                    <div id="writing-feedback" class="mt-3" style="display:none;"></div>
                </div>
            </div>
            break;

        case "free-conversation":
            <div class="text-center mb-4">
                <h5>Free Conversation</h5>
                <p class="text-muted">Chat naturally in Japanese with AI.</p>
            </div>
            <div class="na-conversation-area" id="conversation-area">
                <div class="na-conv-msg na-conv-msg--bot">
                    こんにちは！今日は何を話しましょうか？
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <input type="text" id="conv-input" class="form-control" placeholder="Type in Japanese or English..." />
                <button class="btn-na-primary" id="conv-send"><i class="bi bi-send"></i></button>
            </div>
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <button class="na-chip na-chip--sm conv-topic" data-topic="Casual Conversation">Casual</button>
                <button class="na-chip na-chip--sm conv-topic" data-topic="Travel">Travel</button>
                <button class="na-chip na-chip--sm conv-topic" data-topic="Food">Food</button>
                <button class="na-chip na-chip--sm conv-topic" data-topic="Daily Life">Daily Life</button>
            </div>
            break;

        case "role-play":
            <div class="text-center mb-4">
                <h5>Role Play</h5>
                <p class="text-muted">Practice real-life situations in Japanese.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap mb-3 justify-content-center">
                <button class="na-chip role-scenario" data-scenario="ordering">🍜 Ordering Food</button>
                <button class="na-chip role-scenario" data-scenario="hotel">🏨 Hotel Check-in</button>
                <button class="na-chip role-scenario" data-scenario="train">🚉 Buying a Train Ticket</button>
                <button class="na-chip role-scenario" data-scenario="shopping">🛍 Shopping</button>
                <button class="na-chip role-scenario" data-scenario="classmate">🏫 Meeting a Classmate</button>
            </div>
            <div class="na-conversation-area" id="roleplay-area">
                <div class="text-center text-muted py-4">Choose a scenario to begin</div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <input type="text" id="roleplay-input" class="form-control" placeholder="Type your response..." />
                <button class="btn-na-primary" id="roleplay-send"><i class="bi bi-send"></i></button>
            </div>
            break;

        case "pronunciation":
            <div class="text-center mb-3">
                <h5>Pronunciation Practice</h5>
                <p class="text-muted">Listen, repeat, and compare.</p>
            </div>
            <div class="na-card-flat p-4 mb-3 text-center">
                <div id="pron-word" style="font-size:2rem;font-weight:600;" class="mb-2"></div>
                <div id="pron-romaji" class="text-muted mb-3"></div>
                <button class="na-speak-btn" id="pron-play-btn" style="width:56px;height:56px;font-size:1.3rem;">
                    <i class="bi bi-volume-up-fill"></i>
                </button>
            </div>
            <div class="text-center">
                <button class="btn-na-outline" id="pron-record-btn">
                    <i class="bi bi-mic"></i> Repeat
                </button>
                <div id="pron-feedback" class="mt-3" style="display:none;"></div>
            </div>
            <div class="text-center mt-3">
                <button class="btn-na-primary btn-sm" id="pron-next-btn">Next</button>
            </div>
            break;

        case "handwriting":
            <div class="text-center mb-3">
                <h5>Handwriting</h5>
                <p class="text-muted">Trace, compare, then write kana and kanji from memory.</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="na-card-flat p-4 text-center mb-3">
                        <div id="hw-target" style="font-size:4rem;font-weight:600;color:var(--na-primary);" class="mb-2"></div>
                        <div id="hw-romaji" class="text-muted mb-2"></div>
                        <div id="hw-meaning" class="small text-muted mb-3"></div>
                        <button type="button" class="btn-na-outline btn-sm" id="hw-hear"><i class="bi bi-volume-up"></i> Hear</button>
                        <button type="button" class="btn-na-outline btn-sm" id="hw-stroke-btn"><i class="bi bi-eye"></i> Hide guide</button>
                    </div>
                    <p class="small text-muted text-center">Trace the pale model first, then hide it and write from memory. The grid helps you compare size and balance.</p>
                    <div class="handwriting-canvas-shell">
                        <canvas id="hw-guide-canvas" width="300" height="300" aria-hidden="true"></canvas>
                        <canvas id="hw-canvas" width="300" height="300" aria-label="Handwriting practice canvas"></canvas>
                    </div>
                    <div class="small text-muted text-center mt-2">Strokes drawn: <strong id="hw-stroke-count">0</strong></div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn-na-outline btn-sm" id="hw-undo"><i class="bi bi-arrow-counterclockwise"></i> Undo</button>
                        <button type="button" class="btn-na-outline btn-sm" id="hw-clear">Clear</button>
                        <button type="button" class="btn-na-primary btn-sm" id="hw-check">Compare</button>
                        <button type="button" class="btn-na-primary btn-sm" id="hw-next">Next</button>
                    </div>
                    <div id="hw-feedback" class="text-center mt-3" aria-live="polite"></div>
                </div>
            </div>
            break;

        default:
            <div class="text-center py-5">
                <div style="font-size:3rem;">🚧</div>
                <h5 class="mt-3">Coming Soon</h5>
                <p class="text-muted">This practice mode is being developed. Try another mode!</p>
                <a asp-action="Index" class="btn-na-outline">Back to Practice</a>
            </div>
            break;
    }
</div>

<div class="mt-4">
    <a asp-action="Index" class="na-link-soft"><i class="bi bi-arrow-left"></i> Back to Practice</a>
</div>

@if (vocab != null && vocab.Any())
{
    <script id="mode-vocab-data" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vocab.Select(v => new {
            v.Id, v.Japanese, v.Romaji, v.English, v.PartOfSpeech,
            v.ExampleJapanese, v.ExampleReading, v.ExampleEnglish
        })))
    </script>
}

@section Scripts {
    <script src="~/js/practice-mode.js" asp-append-version="true"></script>
}
