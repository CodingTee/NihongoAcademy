@{
    ViewData["Title"] = "Practice This Lesson";
    var lesson = ViewBag.Lesson as NihongoAcademy.Models.Lesson;
    var vocabulary = ViewBag.Vocabulary as IEnumerable<NihongoAcademy.Models.Vocabulary>;
    var reviewVocabulary = ViewBag.ReviewVocabulary as IEnumerable<NihongoAcademy.Models.Vocabulary> ?? Enumerable.Empty<NihongoAcademy.Models.Vocabulary>();
    var quizzes = ViewBag.Quizzes as IEnumerable<NihongoAcademy.Models.Quiz>;
    var requiresProduction = ViewBag.RequiresProduction == true;
    var isMastered = ViewBag.IsMastered == true;
    var masteryReviewDueDate = ViewBag.MasteryReviewDueDate as DateTime?;
    var masteryReviewDueText = masteryReviewDueDate?.ToString("g");
    var itemCount = vocabulary?.Count() ?? 0;
    var activities = ViewBag.Activities as List<NihongoAcademy.Models.LessonActivity> ?? new();
    var masteryEvaluation = ViewBag.MasteryEvaluation as NihongoAcademy.Services.MasteryEvaluation;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Index">Lessons</a></li>
        <li class="breadcrumb-item"><a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson?.Id">@lesson?.Title</a></li>
        <li class="breadcrumb-item active">Practice</li>
    </ol>
</nav>

<div class="mb-4">
    <h2><i class="bi bi-lightning-charge na-page-icon"></i> Practice This Lesson</h2>
    @if (lesson != null)
    {
        <h5 class="text-na-primary">@lesson.Title</h5>
        <p class="text-muted">5–10 min reinforcement · No setup needed</p>
    }
</div>
@Html.AntiForgeryToken()
<input type="hidden" id="lesson-practice-id" value="@lesson?.Id" />
<div class="na-card-flat p-3 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <strong>Mastery check</strong>
            <div class="small text-muted">Cover all @itemCount learning items and get at least 80% in recognition, listening and recall@(requiresProduction ? ", then complete the output task" : ""). Stable mastery requires a shorter review on a later day.</div>
            @if (!isMastered && masteryReviewDueText != null)
            {
                <div class="small text-na-primary mt-1">First pass complete · delayed review available @masteryReviewDueText</div>
            }
        </div>
        <span id="mastery-status" class="na-chip @(isMastered ? "text-success" : masteryReviewDueDate.HasValue ? "text-na-primary" : "")">@(isMastered ? "Mastered" : masteryReviewDueDate.HasValue ? "Review pending" : "In progress")</span>
    </div>
</div>
@if (masteryEvaluation != null)
{
    <partial name="_MasteryProgressPartial" model="@(new NihongoAcademy.Models.MasteryProgressViewModel { Evaluation = masteryEvaluation, ItemCount = itemCount, RequiresProduction = requiresProduction })" />
}

@* ===== EXERCISE TABS ===== *@
<div class="na-tabs-scroll mb-4">
    @if (activities.Any(a => a.ActivityType == "dialogue"))
    {
        <button class="na-tab na-tab--active" data-tab="dialogue"><i class="bi bi-chat-dots"></i> Scene Dialogue</button>
    }
    @if (activities.Any(a => a.ActivityType == "comprehension"))
    {
        <button class="na-tab" data-tab="comprehension"><i class="bi bi-headphones"></i> Listening Check</button>
    }
    @if (activities.Any(a => a.ActivityType == "sentence-building"))
    {
        <button class="na-tab" data-tab="sentence-building"><i class="bi bi-bricks"></i> Sentence Builder</button>
    }
    @if (activities.Any(a => a.ActivityType == "correction"))
    {
        <button class="na-tab" data-tab="correction"><i class="bi bi-pencil-square"></i> Fix the Error</button>
    }
    <button class="na-tab @(!activities.Any(a => a.ActivityType == "dialogue") ? "na-tab--active" : "")" data-tab="flashcards"><i class="bi bi-card-text"></i> Flashcards</button>
    <button class="na-tab" data-tab="recognition"><i class="bi bi-eye"></i> Recognition</button>
    <button class="na-tab" data-tab="listening"><i class="bi bi-ear"></i> Listening</button>
    <button class="na-tab" data-tab="recall"><i class="bi bi-pencil"></i> Recall</button>
    @if (requiresProduction)
    {
        <button class="na-tab" data-tab="production"><i class="bi bi-chat-square-text"></i> Output Task</button>
    }
    @if (quizzes != null && quizzes.Any())
    {
        <button class="na-tab" data-tab="quiz"><i class="bi bi-patch-question"></i> Mini Quiz</button>
    }
</div>

@if (activities.Any(a => a.ActivityType == "dialogue"))
{
    <div id="tab-dialogue" class="na-practice-tab">
        @foreach (var activity in activities.Where(a => a.ActivityType == "dialogue"))
        {
            <div class="na-card-flat p-4 mb-3">
                <h5>Real-life scene</h5>
                <p class="text-muted">@activity.Prompt</p>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">Learner speed</div>
                        @if (!string.IsNullOrWhiteSpace(activity.SlowAudioUrl))
                        {
                            <audio controls preload="none" class="w-100" src="@activity.SlowAudioUrl">Learner-speed Japanese audio</audio>
                            <button type="button" class="btn btn-link btn-sm p-0 mt-1" data-speak="@activity.JapaneseText" data-rate="0.72"><i class="bi bi-shield-check"></i> System voice backup</button>
                        }
                        else
                        { <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.72"><i class="bi bi-volume-down-fill"></i> System voice</button> }
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted mb-1">Natural speed</div>
                        @if (!string.IsNullOrWhiteSpace(activity.NaturalAudioUrl))
                        {
                            <audio controls preload="none" class="w-100" src="@activity.NaturalAudioUrl">Natural-speed Japanese audio</audio>
                            <button type="button" class="btn btn-link btn-sm p-0 mt-1" data-speak="@activity.JapaneseText" data-rate="0.95"><i class="bi bi-shield-check"></i> System voice backup</button>
                        }
                        else
                        { <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.95"><i class="bi bi-volume-up-fill"></i> System voice</button> }
                    </div>
                </div>
                <div class="p-3 bg-light rounded" style="white-space:pre-line" lang="ja">@activity.JapaneseText</div>
                @if (!string.IsNullOrWhiteSpace(activity.ReadingSupportText))
                {
                    <details class="mt-2 reading-support"><summary><i class="bi bi-spellcheck"></i> Reading help · よみかた</summary><div class="mt-2 p-2 rounded" style="white-space:pre-line" lang="ja">@activity.ReadingSupportText</div></details>
                }
                <details class="mt-3"><summary>Show meaning</summary><div class="mt-2" style="white-space:pre-line">@activity.EnglishText</div></details>
            </div>
        }
    </div>
}

@if (activities.Any(a => a.ActivityType == "comprehension"))
{
    <div id="tab-comprehension" class="na-practice-tab" style="display:none;">
        @foreach (var activity in activities.Where(a => a.ActivityType == "comprehension"))
        {
            var options = System.Text.Json.JsonSerializer.Deserialize<string[]>(activity.OptionsJson ?? "[]") ?? Array.Empty<string>();
            <div class="na-card-flat p-4 mb-3 activity-card" data-activity-id="@activity.Id" data-activity-type="comprehension">
                @if (!string.IsNullOrWhiteSpace(activity.JapaneseText))
                {
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (!string.IsNullOrWhiteSpace(activity.SlowAudioUrl))
                        {
                            <audio controls preload="none" src="@activity.SlowAudioUrl" aria-label="Learner-speed Japanese audio"></audio>
                            <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.72"><i class="bi bi-shield-check"></i> System backup</button>
                        }
                        else
                        { <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.72"><i class="bi bi-volume-down-fill"></i> Learner speed · system voice</button> }
                        @if (!string.IsNullOrWhiteSpace(activity.NaturalAudioUrl))
                        {
                            <audio controls preload="none" src="@activity.NaturalAudioUrl" aria-label="Natural-speed Japanese audio"></audio>
                            <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.95"><i class="bi bi-shield-check"></i> System backup</button>
                        }
                        else
                        { <button type="button" class="btn-na-outline btn-sm" data-speak="@activity.JapaneseText" data-rate="0.95"><i class="bi bi-volume-up-fill"></i> Natural speed · system voice</button> }
                    </div>
                }
                <h5>@activity.Prompt</h5>
                @if (!string.IsNullOrWhiteSpace(activity.ReadingSupportText))
                {
                    <details class="mb-2 reading-support"><summary><i class="bi bi-spellcheck"></i> Reading help · よみかた</summary><div class="mt-2" style="white-space:pre-line" lang="ja">@activity.ReadingSupportText</div></details>
                }
                <div class="d-grid gap-2 mt-3">
                    @foreach (var option in options)
                    {
                        <button type="button" class="btn-na-outline activity-answer" data-answer="@option">@option</button>
                    }
                </div>
                <div class="activity-feedback mt-3"></div>
            </div>
        }
    </div>
}

@if (activities.Any(a => a.ActivityType == "correction"))
{
    <div id="tab-correction" class="na-practice-tab" style="display:none;">
        @foreach (var activity in activities.Where(a => a.ActivityType == "correction"))
        {
            <div class="na-card-flat p-4 mb-3 activity-card" data-activity-id="@activity.Id" data-activity-type="correction">
                <span class="na-badge mb-2" style="background:#FFF0EE;color:var(--na-primary-dark);">Input required · no choices</span>
                <h5>@activity.Prompt</h5>
                <div class="p-3 bg-light rounded mt-3" lang="ja">@activity.JapaneseText</div>
                @if (!string.IsNullOrWhiteSpace(activity.ReadingSupportText))
                {
                    <details class="mt-2 reading-support"><summary><i class="bi bi-spellcheck"></i> Reading help · よみかた</summary><div class="mt-2" lang="ja">@activity.ReadingSupportText</div></details>
                }
                <label class="form-label mt-3">Corrected Japanese sentence</label>
                <input class="form-control activity-input" lang="ja" autocomplete="off" placeholder="Type the complete corrected sentence" />
                <button type="button" class="btn-na-primary activity-submit mt-3">Check correction</button>
                <div class="activity-feedback mt-3"></div>
            </div>
        }
    </div>
}

@if (activities.Any(a => a.ActivityType == "sentence-building"))
{
    <div id="tab-sentence-building" class="na-practice-tab" style="display:none;">
        @foreach (var activity in activities.Where(a => a.ActivityType == "sentence-building"))
        {
            var tokens = System.Text.Json.JsonSerializer.Deserialize<string[]>(activity.OptionsJson ?? "[]") ?? Array.Empty<string>();
            <div class="na-card-flat p-4 mb-3 activity-card" data-activity-id="@activity.Id" data-activity-type="sentence-building">
                <h5>@activity.Prompt</h5>
                @if (!string.IsNullOrWhiteSpace(activity.ReadingSupportText))
                {
                    <details class="reading-support"><summary><i class="bi bi-spellcheck"></i> Reading help · よみかた</summary><div class="mt-2" lang="ja">@activity.ReadingSupportText</div></details>
                }
                <input class="form-control activity-input mt-3" lang="ja" placeholder="Type the complete Japanese sentence" />
                <div class="small text-muted mt-2">Word bank: @string.Join("　", tokens)</div>
                <button type="button" class="btn-na-primary activity-submit mt-3">Check sentence</button>
                <div class="activity-feedback mt-3"></div>
            </div>
        }
    </div>
}

@if (requiresProduction)
{
    <div id="tab-production" class="na-practice-tab" style="display:none;">
        <div class="na-card-flat p-4">
            <h5>Use Japanese for the situation</h5>
            @if (lesson?.Title.Contains("Greetings for the situation") == true)
            {
                <p>Write three different greetings: one for your teacher in the morning, one for a first meeting, and one polite leave-taking.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="先生、おはようございます。…"></textarea>
            }
            else if (lesson?.Title.Contains("Introduce yourself") == true)
            {
                <p>Write or say a first-meeting introduction containing a greeting, your name, where you are from, your role, and a suitable closing.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="はじめまして。…"></textarea>
            }
            else if (lesson?.Title.Contains("family") == true)
            {
                <p>Introduce at least three people from a real or imaginary family, then describe one person's relationship or role.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="これは わたしの ははです。…"></textarea>
            }
            else if (lesson?.Title.Contains("Describe people") == true)
            {
                <p>Introduce one family member or friend. Include the relationship or name, a role, and one quality.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="これは わたしの ともだちです。…"></textarea>
            }
            else if (lesson?.Title.Contains("Identify everyday things") == true)
            {
                <p>Imagine three objects on a table. Ask what one is, identify another, and ask who owns the third.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="これは何ですか。それは…"></textarea>
            }
            else if (lesson?.Title.Contains("numbers, ages and prices") == true)
            {
                <p>Write your age, ask the price of an item, and respond with a price of at least three digits.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="わたしは…歳です。これはいくらですか。…円です。"></textarea>
            }
            else if (lesson?.Title.Contains("Tell time") == true)
            {
                <p>Write a three-part schedule with a day, starting time and ending time, then ask when another activity begins.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="月曜日の九時から…までです。…はいつですか。"></textarea>
            }
            else if (lesson?.Title.Contains("daily routine") == true)
            {
                <p>Describe four actions in your day. Include two clock times, one destination and one negative routine.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="毎朝七時におきます。…"></textarea>
            }
            else if (lesson?.Title.Contains("Find people and things") == true)
            {
                <p>Describe where one person, one animal and two objects are. Choose います and あります correctly.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="教室に先生がいます。つくえの上に…"></textarea>
            }
            else if (lesson?.Title.Contains("Describe places and objects") == true)
            {
                <p>Describe a familiar place with two positive qualities, one negative quality and one connected adjective sentence.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="この町はしずかで、きれいです。…"></textarea>
            }
            else if (lesson?.Title.Contains("likes and abilities") == true)
            {
                <p>State two things you like, one thing you can do and one thing you cannot do. Ask the listener one question.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="音楽が好きです。料理ができます。…"></textarea>
            }
            else if (lesson?.Title.Contains("requests and ask permission") == true)
            {
                <p>Write one polite request, one permission question and one prohibition for a classroom or public place.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="ちょっと待ってください。ここで…てもいいですか。"></textarea>
            }
            else if (lesson?.Title.Contains("Order food and drinks") == true)
            {
                <p>Role-play a complete order with two different items, quantities, a drink and a request for the total.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="ラーメンを一つと、お茶を二杯お願いします。…"></textarea>
            }
            else if (lesson?.Title.Contains("Shop for an item") == true)
            {
                <p>Ask for an item in a colour or size, ask the price, choose it and state how you will pay.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="青はありますか。いくらですか。これにします。…"></textarea>
            }
            else if (lesson?.Title.Contains("Travel and ask directions") == true)
            {
                <p>Ask how to reach a place, then write a two-step direction and name the transport you will use.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="駅から…までどうやって行きますか。まっすぐ行って…"></textarea>
            }
            else if (lesson?.Title.Contains("Invite someone") == true)
            {
                <p>Invite someone to an activity, propose a day and time, then write both an accepting and a polite declining response.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="いっしょに…ませんか。いいですね。／すみません、…はちょっと。"></textarea>
            }
            else if (lesson?.Title.Contains("past day") == true)
            {
                <p>Describe yesterday using two positive past actions, one negative past action and one past adjective.</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="きのう公園に行きました。…しませんでした。楽しかったです。"></textarea>
            }
            else if (lesson?.Title.Contains("real-life mission") == true)
            {
                <p>Complete the mission in Japanese: introduce yourself, arrange a meeting, ask directions, order something and repair one misunderstanding.</p>
                <textarea id="production-input" class="form-control" rows="7" lang="ja" placeholder="はじめまして。…もう一度ゆっくりお願いします。"></textarea>
            }
            else
            {
                <p>@lesson?.Description</p>
                <textarea id="production-input" class="form-control" rows="5" lang="ja" placeholder="Write or role-play your response in Japanese…"></textarea>
            }
            <div class="form-check mt-3"><input class="form-check-input production-check" type="checkbox" id="pc1"><label class="form-check-label" for="pc1">My message fits the situation.</label></div>
            <div class="form-check"><input class="form-check-input production-check" type="checkbox" id="pc2"><label class="form-check-label" for="pc2">I used the core expressions without copying the model.</label></div>
            <div class="form-check"><input class="form-check-input production-check" type="checkbox" id="pc3"><label class="form-check-label" for="pc3">I read it aloud once and it was understandable.</label></div>
            <button id="production-complete" class="btn-na-primary mt-3">Complete output task</button>
            <div id="production-feedback" class="mt-3"></div>
        </div>
    </div>
}

@* ===== ACTIVE RECALL ===== *@
<div id="tab-recall" class="na-practice-tab" style="display:none;">
    <div class="na-card-flat p-4">
        <div class="text-center mb-3">
            <h5>Type the kana for “<span id="recall-target"></span>”</h5>
            <p class="small text-muted">This tests recall without showing answer choices.</p>
            <div id="recall-kind" class="small text-muted">Current lesson target</div>
        </div>
        <div class="row justify-content-center"><div class="col-sm-6 col-md-4">
            <input id="recall-input" class="form-control form-control-lg text-center" lang="ja" autocomplete="off" />
            <button id="recall-check" class="btn-na-primary w-100 mt-3">Check</button>
            <div id="recall-feedback" class="text-center mt-3"></div>
        </div></div>
    </div>
</div>

@* ===== FLASHCARDS ===== *@
<div id="tab-flashcards" class="na-practice-tab" style="@(activities.Any(a => a.ActivityType == "dialogue") ? "display:none;" : "")">
    @if (vocabulary != null && vocabulary.Any())
    {
        <div class="text-center mb-3">
            <small class="text-muted">Click a card to flip · Use arrow keys to navigate</small>
        </div>
        <div class="flashcard-container" id="lesson-flashcard">
            <div class="flashcard" id="lesson-flashcard-inner">
                <div class="flashcard-face flashcard-front">
                    <div class="flashcard-jp" id="fc-jp">@vocabulary.First().Japanese</div>
                    <div class="flashcard-romaji" id="fc-romaji">@vocabulary.First().Romaji</div>
                </div>
                <div class="flashcard-face flashcard-back">
                    <div class="flashcard-english" id="fc-en">@vocabulary.First().English</div>
                    <div class="flashcard-type" id="fc-pos">@vocabulary.First().PartOfSpeech</div>
                    @if (!string.IsNullOrEmpty(vocabulary.First().ExampleJapanese))
                    {
                        <div class="flashcard-example" id="fc-ex">
                            @vocabulary.First().ExampleJapanese<br />
                            @if (!string.IsNullOrWhiteSpace(vocabulary.First().ExampleReading) && vocabulary.First().ExampleReading != vocabulary.First().ExampleJapanese)
                            {
                                <small class="text-na-primary" id="fc-reading">@vocabulary.First().ExampleReading</small><br />
                            }
                            else
                            {
                                <small class="text-na-primary" id="fc-reading"></small>
                            }
                            <small>@vocabulary.First().ExampleEnglish</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-center align-items-center gap-3 mt-3" id="fc-nav">
            <button class="btn-na-outline btn-sm" id="fc-prev"><i class="bi bi-arrow-left"></i></button>
            <small class="text-muted" id="fc-counter">1 / @vocabulary.Count()</small>
            <button class="btn-na-outline btn-sm" id="fc-next"><i class="bi bi-arrow-right"></i></button>
        </div>

        <div class="d-flex justify-content-center gap-2 mt-3" id="fc-rating">
            <button class="btn-na-outline btn-sm fc-rate" data-quality="1" title="Didn't know it: review again in 10 minutes">Again</button>
            <button class="btn-na-outline btn-sm fc-rate" data-quality="2" title="Knew it but with effort: short interval">Hard</button>
            <button class="btn-na-outline btn-sm fc-rate" data-quality="3" title="Remembered it: standard interval (1 day the first time)">Good</button>
            <button class="btn-na-outline btn-sm fc-rate" data-quality="4" title="Too easy: longer interval">Easy</button>
        </div>
        <div class="text-center mt-2">
            <small class="text-muted">Again = 10 min · Hard = short · Good = 1 day · Easy = longer</small>
        </div>

        <div id="fc-complete" class="text-center py-4" style="display:none;">
            <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem;"></i>
            <h5 class="mt-2">Lesson flashcards complete!</h5>
            <p class="text-muted">Your ratings were saved. Come back later to review the words you marked Again.</p>
            <button class="btn-na-primary btn-sm" id="fc-restart">Study Again</button>
        </div>

        @* Hidden data for JS *@
        <script id="lesson-vocab-data" type="application/json">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vocabulary.Select(v => new {
                v.Id, v.Japanese, v.Romaji, v.English, v.PartOfSpeech, IsReview = false,
                v.ExampleJapanese, v.ExampleReading, v.ExampleEnglish
            })))
        </script>
        <script id="lesson-review-vocab-data" type="application/json">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reviewVocabulary.Select(v => new {
                v.Id, v.Japanese, v.Romaji, v.English, v.PartOfSpeech, IsReview = true,
                v.ExampleJapanese, v.ExampleReading, v.ExampleEnglish
            })))
        </script>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size:2rem;"></i>
            <p class="mt-2">No vocabulary available for this lesson yet.</p>
        </div>
    }
</div>

@* ===== RECOGNITION ===== *@
<div id="tab-recognition" class="na-practice-tab" style="display:none;">
    <div id="recognition-exercise" class="na-card-flat p-4">
        @if (vocabulary != null && vocabulary.Any())
        {
            <div class="text-center mb-3">
                <h5 id="rec-question">Which character is "<span id="rec-target"></span>"?</h5>
                <div id="rec-kind" class="small text-muted">Current lesson target</div>
            </div>
            <div class="row g-2 justify-content-center" id="rec-options">
                @* Populated by JS *@
            </div>
            <div class="text-center mt-3">
                <button class="btn-na-primary btn-sm" id="rec-next-btn">Next Question</button>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <p>No vocabulary available for recognition.</p>
            </div>
        }
    </div>
</div>

@* ===== LISTENING ===== *@
<div id="tab-listening" class="na-practice-tab" style="display:none;">
    <div id="listening-exercise" class="na-card-flat p-4">
        @if (vocabulary != null && vocabulary.Any())
        {
            <div class="text-center mb-3">
                <button class="na-speak-btn" id="listen-play-btn" style="width:64px;height:64px;font-size:1.5rem;">
                    <i class="bi bi-volume-up-fill"></i>
                </button>
                <p class="mt-2 text-muted">Which character did you hear?</p>
                <div id="listen-kind" class="small text-muted">Current lesson target</div>
            </div>
            <div class="row g-2 justify-content-center" id="listen-options">
                @* Populated by JS *@
            </div>
            <div class="text-center mt-3">
                <button class="btn-na-primary btn-sm" id="listen-next-btn">Next Question</button>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <p>No vocabulary available for listening.</p>
            </div>
        }
    </div>
</div>

@* ===== MINI QUIZ ===== *@
<div id="tab-quiz" class="na-practice-tab" style="display:none;">
    @if (quizzes != null && quizzes.Any())
    {
        <div class="text-center py-4">
            <i class="bi bi-patch-question" style="font-size:2rem; color:var(--na-primary);"></i>
            <h5 class="mt-2">Mini Quiz</h5>
            <p class="text-muted">5 questions to test your understanding</p>
            <a asp-controller="Quizzes" asp-action="Session" asp-route-mode="take" asp-route-id="@quizzes.First().Id" class="btn-na-primary">
                <i class="bi bi-play-fill"></i> Start Mini Quiz
            </a>
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox" style="font-size:2rem;"></i>
            <p class="mt-2">No quiz available for this lesson yet.</p>
        </div>
    }
</div>

<div class="mt-4">
    <a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson?.Id" class="na-link-soft">
        <i class="bi bi-arrow-left"></i> Back to Lesson
    </a>
</div>

@section Scripts {
    <script src="~/js/lesson-practice.js" asp-append-version="true"></script>
}
