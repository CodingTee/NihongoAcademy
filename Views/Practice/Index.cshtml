@{
    ViewData["Title"] = "Practice";
    var dueCount = ViewBag.DueCount ?? 0;
    var weakAreas = ViewBag.WeakAreas as List<string> ?? new List<string>();
    var dueMasteryReviews = ViewBag.DueMasteryReviews as List<NihongoAcademy.Models.LessonProgress> ?? new();
    var pendingMasteryReviewCount = ViewBag.PendingMasteryReviewCount as int? ?? 0;
    var topics = ViewBag.Topics as IEnumerable<NihongoAcademy.Models.Category>;
    var topicVocabCounts = ViewBag.TopicVocabCounts as Dictionary<int, int>;
    var topicIcons = new Dictionary<string, string>
    {
        ["Hiragana"] = "あ", ["Katakana"] = "ア", ["Vocabulary"] = "語",
        ["Grammar"] = "文", ["Kanji"] = "漢", ["Animals"] = "🐶",
        ["Food"] = "🍎", ["Colors"] = "🎨", ["Clothing"] = "👕",
        ["Family"] = "👨‍👩‍👧", ["School"] = "🏫", ["Weather"] = "🌦",
        ["Time & Numbers"] = "🕐", ["Travel"] = "🚉", ["Daily Life"] = "🏠"
    };
}

@* ===== Page banner ===== *@
<section class="na-page-hero-v2" aria-label="Practice">
    <div class="na-hero-v2-deco" aria-hidden="true">
        <span class="na-hero-v2-glyph na-hero-v2-glyph--a">練</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--b">習</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--c">あ</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--d">語</span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
    </div>
    <div class="na-page-hero-v2-inner">
        <span class="na-page-hero-v2-eyebrow"><i class="bi bi-stars"></i> Train Every Skill</span>
        <h1 class="na-page-hero-v2-title">Practice <span>練習</span></h1>
        <p class="na-page-hero-v2-lead">Train your Japanese your way. Listening, speaking, reading, writing, and spaced repetition.</p>
    </div>
</section>



<div class="na-card mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div><span class="na-badge">A1 CAPSTONE</span><h4 class="mt-2 mb-1">A1 Integrated Can-do Completion <span class="na-subtitle-jp">総合修了</span></h4><p class="text-muted mb-0">Bring stable lesson mastery, the final quiz, listening, reading, speaking and writing together.</p></div>
    <a asp-action="Capstone" asp-route-level="A1" class="btn-na-primary text-nowrap"><i class="bi bi-award"></i> View A1 completion</a>
</div>
<div class="na-card mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div><span class="na-badge">A2 CAPSTONE</span><h4 class="mt-2 mb-1">A2 Integrated Can-do Completion <span class="na-subtitle-jp">総合修了</span></h4><p class="text-muted mb-0">Confirm independent listening, reading, speaking and writing after the full A2 pathway.</p></div>
    <a asp-action="Capstone" asp-route-level="A2" class="btn-na-primary text-nowrap"><i class="bi bi-award-fill"></i> View A2 completion</a>
</div>

@* ===== TODAY'S PRACTICE ===== *@
<div class="na-today-stats" data-tour="tour-practice-today">
    <div class="na-today-stat">
        <div class="na-today-stat__number">@dueCount</div>
        <div class="na-today-stat__label">Cards Due</div>
    </div>
    <div class="na-today-stat">
        <div class="na-today-stat__number">@weakAreas.Count</div>
        <div class="na-today-stat__label">Weak Areas</div>
    </div>
    <div class="na-today-stat">
        <div class="na-today-stat__number">@dueMasteryReviews.Count</div>
        <div class="na-today-stat__label">Mastery Reviews</div>
    </div>
</div>
@if (dueMasteryReviews.Count > 0 || dueCount > 0 || weakAreas.Count > 0)
{
    <div class="na-today-start">
        @if (dueMasteryReviews.Count > 0)
        {
            <a asp-action="LessonPractice" asp-route-lessonId="@dueMasteryReviews[0].LessonId" class="btn-na-primary">
                <i class="bi bi-clock-history"></i> Start Due Mastery Review
            </a>
        }
        else
        {
            <a asp-action="AdaptiveReview" class="btn-na-primary">
                <i class="bi bi-stars"></i> Start Recommended Practice
            </a>
        }
    </div>
}

@if (dueMasteryReviews.Count > 0 || pendingMasteryReviewCount > 0)
{
    <div class="na-practice-section">
        <div class="na-practice-section__title"><i class="bi bi-clock-history"></i> Stable Mastery Reviews</div>
        @if (dueMasteryReviews.Count > 0)
        {
            <div class="list-group">
                @foreach (var review in dueMasteryReviews)
                {
                    <a asp-action="LessonPractice" asp-route-lessonId="@review.LessonId"
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3">
                        <span>
                            <strong>@review.Lesson?.Title</strong>
                            <small class="d-block text-muted">@review.Lesson?.JapaneseTitle · @review.Lesson?.Category?.Name</small>
                        </span>
                        <span class="na-badge text-nowrap" style="background:#E1E4E7;color:#d96d80;">
                            <i class="bi bi-bell-fill"></i> Due now
                        </span>
                    </a>
                }
            </div>
        }
        @if (pendingMasteryReviewCount > 0)
        {
            <p class="small text-muted mt-2 mb-0">
                <i class="bi bi-hourglass-split"></i>
                @pendingMasteryReviewCount more lesson@(pendingMasteryReviewCount == 1 ? " is" : "s are") waiting for a later-day review.
            </p>
        }
    </div>
}

@* ===== PRACTICE BY SKILL ===== *@
<div class="na-practice-section" data-tour="tour-practice-skills">
    <div class="na-practice-section__title"><i class="bi bi-stars"></i> Practice by Skill</div>
    <div class="na-skill-grid">
        <a asp-action="Library" asp-route-skill="listening" class="na-skill-tile">
            <div class="na-skill-tile__icon">🎧</div>
            <div class="na-skill-tile__info">
                <h6>Listening</h6>
                <small>リスニング</small>
            </div>
        </a>
        <a asp-action="Library" asp-route-skill="reading" class="na-skill-tile">
            <div class="na-skill-tile__icon">📖</div>
            <div class="na-skill-tile__info">
                <h6>Reading</h6>
                <small>リーディング</small>
            </div>
        </a>
        <a asp-action="Library" asp-route-skill="speaking" class="na-skill-tile">
            <div class="na-skill-tile__icon">🎤</div>
            <div class="na-skill-tile__info">
                <h6>Speaking</h6>
                <small>スピーキング</small>
            </div>
        </a>
        <a asp-action="Library" asp-route-skill="writing" class="na-skill-tile">
            <div class="na-skill-tile__icon">✍️</div>
            <div class="na-skill-tile__info">
                <h6>Writing</h6>
                <small>ライティング</small>
            </div>
        </a>
        <a asp-action="Grammar" class="na-skill-tile">
            <div class="na-skill-tile__icon">文</div>
            <div class="na-skill-tile__info">
                <h6>Grammar</h6>
                <small>文法トレーニング</small>
            </div>
        </a>
    </div>
</div>

@* ===== PRACTICE BY TOPIC ===== *@
<div class="na-practice-section">
    <div class="na-practice-section__title"><i class="bi bi-collection"></i> Practice by Topic</div>
    <div class="na-topic-grid">
        @if (topics != null)
        {
            foreach (var topic in topics.Take(10))
            {
                var icon = topicIcons.ContainsKey(topic.Name) ? topicIcons[topic.Name] : "📚";
                var count = topicVocabCounts?.GetValueOrDefault(topic.Id, 0) ?? 0;
                <a asp-action="Topic" asp-route-id="@topic.Id" class="na-topic-chip">
                    <span class="na-topic-chip__emoji">@icon</span>
                    @topic.Name
                    @if (count > 0)
                    {
                        <span class="badge bg-light text-muted" style="font-size:0.7rem;">@count</span>
                    }
                </a>
            }
        }
    </div>
</div>

@* ===== REVIEW ===== *@
<div class="na-practice-section">
    <div class="na-practice-section__title"><i class="bi bi-arrow-repeat"></i> Review</div>
    <div class="na-review-row">
        <div class="na-review-card">
            <div class="na-review-card__icon"><i class="bi bi-card-text"></i></div>
            <h6>Flashcards</h6>
            <small>Review due cards with spaced repetition</small>
            <div class="mt-2">
                <a asp-controller="Flashcards" asp-action="Session" asp-route-mode="practice" class="btn-na-primary btn-sm">Start Review</a>
            </div>
            @if (dueCount > 0)
            {
                <div class="mt-2"><small class="text-na-primary"><i class="bi bi-bell-fill"></i> @dueCount card@(dueCount > 1 ? "s" : "") due</small></div>
            }
        </div>
        <div class="na-review-card">
            <div class="na-review-card__icon"><i class="bi bi-patch-question"></i></div>
            <h6>Quizzes</h6>
            <small>Test what you've learned</small>
            <div class="mt-2">
                <a asp-controller="Quizzes" asp-action="Index" class="btn-na-outline btn-sm">Take a Quiz</a>
            </div>
        </div>
    </div>
</div>

@* ===== CHALLENGE YOURSELF ===== *@
<div class="na-practice-section">
    <div class="na-practice-section__title"><i class="bi bi-trophy"></i> Challenge Yourself</div>
    <div class="na-challenge-grid">
        <a asp-action="Challenge" asp-route-mode="speed" class="na-challenge-card">
            <div class="na-challenge-card__icon">⚡</div>
            <div class="na-challenge-card__label">Speed Round</div>
        </a>
        <a asp-action="Challenge" asp-route-mode="dictation" class="na-challenge-card">
            <div class="na-challenge-card__icon">🎧</div>
            <div class="na-challenge-card__label">Dictation</div>
        </a>
        <a asp-action="SentenceBuilder" class="na-challenge-card">
            <div class="na-challenge-card__icon">🧩</div>
            <div class="na-challenge-card__label">Sentence Builder</div>
            <span class="badge rounded-pill mt-1" style="background:#FFF0F3;color:#ee96a4;font-size:0.72rem;font-weight:700;">+15 XP</span>
        </a>
        <a asp-action="Mode" asp-route-skill="speaking" asp-route-mode="shadowing" class="na-challenge-card">
            <div class="na-challenge-card__icon">🗣</div>
            <div class="na-challenge-card__label">Shadowing</div>
        </a>
        <a asp-action="Challenge" asp-route-mode="mixed" class="na-challenge-card">
            <div class="na-challenge-card__icon">🎯</div>
            <div class="na-challenge-card__label">Mixed Challenge</div>
        </a>
    </div>
</div>
