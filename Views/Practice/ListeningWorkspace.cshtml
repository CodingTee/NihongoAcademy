@model NihongoAcademy.Models.ListeningWorkspaceViewModel
@using System.Text.Json
@{ ViewData["Title"] = Model.Task.Title; var hasAttempt = Model.History.Any(); }

<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="ListeningLibrary">Listening Studio</a></li><li class="breadcrumb-item active">@Model.Task.Title</li></ol></nav>
<div class="d-flex justify-content-between gap-3 mb-4"><div><span class="na-badge">@Model.Task.Level · @Model.Task.TaskType</span><h2 class="mt-2 mb-0">@Model.Task.Title</h2><div class="text-na-primary" lang="ja">@Model.Task.JapaneseTitle</div></div><strong id="listening-mastery" class="@(Model.IsMastered ? "text-success" : "text-muted")">@(Model.IsMastered ? "Stable mastery" : $"{Model.Accuracy}% accuracy")</strong></div>

<div class="row g-4"><div class="col-lg-8">
    <div class="na-card text-center"><h4>Listen to the situation</h4><p class="text-muted">@Model.Task.Situation</p><input type="hidden" id="listening-script" value="@Model.Task.ScriptJapanese" />@Html.AntiForgeryToken()<input type="hidden" id="listening-task-id" value="@Model.Task.Id" />
        <div class="d-flex justify-content-center gap-3 my-4"><button type="button" class="btn-na-outline" id="play-slow"><i class="bi bi-volume-down"></i> Slow</button><button type="button" class="btn-na-primary" id="play-natural"><i class="bi bi-volume-up-fill"></i> Natural</button></div><p class="small text-muted mb-0" id="playback-status">Listen once at natural speed before using slow playback.</p>
    </div>
    <section class="mt-4" id="listening-questions"><h4>Check your understanding</h4>
    @foreach (var question in Model.Task.Questions.OrderBy(q => q.DisplayOrder))
    {
        var options = JsonSerializer.Deserialize<List<string>>(question.OptionsJson ?? "[]") ?? new();
        <article class="na-card-flat mt-3 listening-question" data-question-id="@question.Id"><strong>@question.DisplayOrder. @question.Prompt</strong>
            @if (question.QuestionType == "choice") { <div class="row g-2 mt-2">@foreach (var option in options) { <div class="col-sm-6"><button type="button" class="btn-na-outline btn-sm w-100 listening-answer" data-answer="@option">@option</button></div> }</div> }
            else { <div class="input-group mt-3"><input type="text" class="form-control listening-input" lang="ja" placeholder="Type exactly what you heard…" /><button type="button" class="btn-na-primary listening-submit">Check</button></div> }
            <div class="question-feedback mt-2" aria-live="polite"></div>
        </article>
    }
    </section>
    @if (hasAttempt) { <details class="na-card-flat mt-4"><summary class="fw-semibold">Transcript and meaning</summary><div lang="ja" class="mt-3" style="white-space:pre-line">@Model.Task.ScriptJapanese</div><hr /><div class="small text-muted" style="white-space:pre-line">@Model.Task.ScriptEnglish</div><p class="small mt-2 mb-0">Use the transcript after attempting the questions, then listen again without reading.</p></details> }
</div><aside class="col-lg-4"><div class="na-card-flat mb-3"><h5>Listening Strategy</h5><ol class="small mb-0"><li>Listen for the situation and speakers.</li><li>Catch key words, numbers and actions.</li><li>Answer before revealing the transcript.</li><li>Replay naturally after checking.</li></ol></div><div class="na-card-flat"><h5>Task-specific Tips</h5><ul class="small mb-0">@foreach (var tip in Model.Tips) { <li>@tip</li> }</ul></div><div class="alert alert-light border small mt-3">Stable mastery requires all three questions correct on a later date and at least 80% overall accuracy.</div></aside></div>

@section Scripts { <script src="~/js/listening-workspace.js" asp-append-version="true"></script> }
