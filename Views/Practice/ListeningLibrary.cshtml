@model List<NihongoAcademy.Models.ListeningLibraryItemViewModel>
@{ ViewData["Title"] = "Listening Studio"; var level = ViewBag.Level as string; var type = ViewBag.Type as string; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h2>🎧 Listening Studio <span class="na-subtitle-jp">聴解</span></h2><p class="text-muted mb-0">Hear practical Japanese, understand meaning and rebuild what was said.</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-action="ListeningLibrary" class="@(level == null && type == null ? "btn-na-primary" : "btn-na-outline") btn-sm">All</a><a asp-action="ListeningLibrary" asp-route-level="A1" class="@(level == "A1" ? "btn-na-primary" : "btn-na-outline") btn-sm">A1</a><a asp-action="ListeningLibrary" asp-route-level="A2" class="@(level == "A2" ? "btn-na-primary" : "btn-na-outline") btn-sm">A2</a><a asp-action="ListeningLibrary" asp-route-type="dialogue" class="@(type == "dialogue" ? "btn-na-primary" : "btn-na-outline") btn-sm">Dialogue</a><a asp-action="ListeningLibrary" asp-route-type="announcement" class="@(type == "announcement" ? "btn-na-primary" : "btn-na-outline") btn-sm">Announcement</a></div>
</div>
<div class="alert alert-info"><i class="bi bi-volume-up"></i> System Japanese voice is the complete default audio source. Every task supports slow and natural playback; no human recording is required.</div>
<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-6 col-xl-4"><article class="na-card h-100 @(item.IsUnlocked ? "" : "opacity-50")">
        <div class="d-flex justify-content-between gap-2"><span class="na-badge">@item.Task.Level · @item.Task.TaskType</span><span class="@(item.IsMastered ? "text-success" : "text-muted")">@(item.IsMastered ? "✓ Stable mastery" : $"{item.Accuracy}%")</span></div>
        <h4 class="mt-3 mb-1">@item.Task.Title</h4><div class="text-na-primary" lang="ja">@item.Task.JapaneseTitle</div><p class="small text-muted mt-3">@item.Task.Situation</p>
        <p class="small text-muted">@item.Task.Questions.Count questions · ~@item.Task.EstimatedMinutes min · @item.AttemptCount attempt(s)</p>
        @if (item.IsUnlocked) { <a asp-action="Workspace" asp-route-skill="listening" asp-route-id="@item.Task.Id" class="btn-na-primary btn-sm">@(item.AttemptCount > 0 ? "Listen again" : "Start listening")</a> }
        else { <span class="small text-muted"><i class="bi bi-lock-fill"></i> Complete the earlier lesson first</span> }
    </article></div>
}
</div>
<div class="mt-4"><a asp-action="Listening" class="na-link-soft"><i class="bi bi-arrow-left"></i> Listening modes</a></div>
