@{
    ViewData["Title"] = ViewBag.Category?.Name ?? "Topic Practice";
    var category = ViewBag.Category as NihongoAcademy.Models.Category;
    var vocabulary = ViewBag.Vocabulary as IEnumerable<NihongoAcademy.Models.Vocabulary>;
    var quizzes = ViewBag.Quizzes as IEnumerable<NihongoAcademy.Models.Quiz>;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Practice</a></li>
        <li class="breadcrumb-item active">@category?.Name</li>
    </ol>
</nav>

<div class="mb-4">
    <h2><i class="bi bi-collection na-page-icon"></i> @category?.Name</h2>
    <p class="text-muted">Choose how you want to practise this topic.</p>
</div>

@* ===== PRACTICE OPTIONS ===== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <a asp-controller="Flashcards" asp-action="Practice" asp-route-categoryId="@category?.Id" class="na-mode-card text-decoration-none">
            <div class="na-mode-icon">🗂</div>
            <div class="na-mode-title">Flashcards</div>
            <small class="na-mode-desc">Review vocabulary</small>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-action="Mode" asp-route-skill="listening" asp-route-mode="listen-choose" class="na-mode-card text-decoration-none">
            <div class="na-mode-icon">🎧</div>
            <div class="na-mode-title">Listening</div>
            <small class="na-mode-desc">Hear & identify</small>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-action="Mode" asp-route-skill="reading" asp-route-mode="reading-comprehension" class="na-mode-card text-decoration-none">
            <div class="na-mode-icon">📖</div>
            <div class="na-mode-title">Reading</div>
            <small class="na-mode-desc">Read & understand</small>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-action="Mode" asp-route-skill="speaking" asp-route-mode="pronunciation" class="na-mode-card text-decoration-none">
            <div class="na-mode-icon">🎤</div>
            <div class="na-mode-title">Speaking</div>
            <small class="na-mode-desc">Listen & repeat</small>
        </a>
    </div>
    <div class="col-6 col-md-4">
        @if (quizzes != null && quizzes.Any())
        {
            <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@quizzes.First().Id" class="na-mode-card text-decoration-none">
                <div class="na-mode-icon">📝</div>
                <div class="na-mode-title">Quiz</div>
                <small class="na-mode-desc">Test your knowledge</small>
            </a>
        }
        else
        {
            <div class="na-mode-card na-mode-card--disabled">
                <div class="na-mode-icon">📝</div>
                <div class="na-mode-title">Quiz</div>
                <small class="na-mode-desc">Coming soon</small>
            </div>
        }
    </div>
</div>

@* ===== VOCABULARY PREVIEW ===== *@
@if (vocabulary != null && vocabulary.Any())
{
    <div class="na-section mb-4">
        <h5 class="na-section-title"><i class="bi bi-book text-na-primary"></i> Vocabulary in This Topic</h5>
        <div class="row g-2">
            @foreach (var v in vocabulary.Take(12))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="na-topic-vocab-card">
                        <span class="na-topic-vocab-jp">@v.Japanese</span>
                        <span class="na-topic-vocab-romaji">@v.Romaji</span>
                        <span class="na-topic-vocab-en">@v.English</span>
                        <button type="button" class="na-speak-btn na-speak-btn-sm na-topic-vocab-speak"
                                data-speak="@v.Japanese" title="Hear pronunciation">
                            <i class="bi bi-volume-up-fill"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        @if (vocabulary.Count() > 12)
        {
            <a asp-controller="Flashcards" asp-action="Index" asp-route-categoryId="@category?.Id" class="na-link-soft mt-2 d-block">
                View all @vocabulary.Count() words <i class="bi bi-arrow-right"></i>
            </a>
        }
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="na-link-soft"><i class="bi bi-arrow-left"></i> Back to Practice</a>
</div>
