@model List<NihongoAcademy.Models.WritingLibraryItemViewModel>
@{ ViewData["Title"] = "Writing Studio"; var level = ViewBag.Level as string; var type = ViewBag.Type as string; }

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h2>✍️ Writing Studio <span class="na-subtitle-jp">作文</span></h2><p class="text-muted mb-0">Build, check, revise and revisit practical Japanese writing.</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-action="WritingLibrary" class="@(level == null && type == null ? "btn-na-primary" : "btn-na-outline") btn-sm">All</a><a asp-action="WritingLibrary" asp-route-level="A1" class="@(level == "A1" ? "btn-na-primary" : "btn-na-outline") btn-sm">A1</a><a asp-action="WritingLibrary" asp-route-level="A2" class="@(level == "A2" ? "btn-na-primary" : "btn-na-outline") btn-sm">A2</a><a asp-action="WritingLibrary" asp-route-type="guided" class="@(type == "guided" ? "btn-na-primary" : "btn-na-outline") btn-sm">Guided</a><a asp-action="WritingLibrary" asp-route-type="free" class="@(type == "free" ? "btn-na-primary" : "btn-na-outline") btn-sm">Free</a></div>
</div>

<div class="alert alert-info"><i class="bi bi-info-circle"></i> Automated checks assess structure and required language, not whether every sentence is natural. Always complete the self-checklist and compare with the model after submitting.</div>
<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-6 col-xl-4"><article class="na-card h-100 @(item.IsUnlocked ? "" : "opacity-50")">
        <div class="d-flex justify-content-between"><span class="na-badge">@item.Task.Level · @item.Task.TaskType</span><span class="@(item.IsMastered ? "text-success" : "text-muted")">@(item.IsMastered ? "✓ Stable mastery" : $"Best {item.BestScore}%")</span></div>
        <h4 class="mt-3 mb-1">@item.Task.Title</h4><div class="text-na-primary" lang="ja">@item.Task.JapaneseTitle</div><p class="small text-muted mt-3">@item.Task.Prompt</p>
        <p class="small text-muted">@item.Task.MinimumSentences+ sentences · @item.Task.MinimumJapaneseCharacters+ Japanese characters · @item.SubmissionCount version(s)</p>
        @if (item.IsUnlocked) { <a asp-action="Workspace" asp-route-skill="writing" asp-route-id="@item.Task.Id" class="btn-na-primary btn-sm">@(item.SubmissionCount > 0 ? "Revise writing" : "Start writing")</a> }
        else { <span class="small text-muted"><i class="bi bi-lock-fill"></i> Complete the earlier lesson first</span> }
    </article></div>
}
</div>
<div class="mt-4"><a asp-action="Writing" class="na-link-soft"><i class="bi bi-arrow-left"></i> Writing modes</a></div>
