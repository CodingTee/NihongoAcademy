@{
    ViewData["Title"] = "Dictation Challenge";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Practice</a></li>
        <li class="breadcrumb-item"><a asp-action="Challenges">Challenges</a></li>
        <li class="breadcrumb-item active">Dictation</li>
    </ol>
</nav>

<div class="mb-4">
    <h2><span class="me-2">🎧</span> Dictation Challenge</h2>
    <p class="text-muted">Listen carefully and type what you hear.</p>
</div>

<div class="na-card-flat p-4 text-center" id="dictation-area">
    <div class="mb-3">
        <button class="na-speak-btn" id="dict-play-btn" style="width:64px;height:64px;font-size:1.5rem;">
            <i class="bi bi-volume-up-fill"></i>
        </button>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-6">
            <input type="text" id="dict-input" class="form-control form-control-lg text-center" placeholder="Type what you hear..." autocomplete="off" />
            <div class="mt-3">
                <button class="btn-na-primary" id="dict-check-btn">Check Answer</button>
            </div>
            <div id="dict-feedback" class="mt-3" style="display:none;"></div>
            <div class="mt-2">
                <button class="btn-na-outline btn-sm" id="dict-next-btn" style="display:none;">Next</button>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Challenges" class="na-link-soft"><i class="bi bi-arrow-left"></i> Back to Challenges</a>
</div>

@section Scripts {
    <script>
    (function() {
        const words = [
            {j:"おはようございます",r:"ohayou gozaimasu",e:"Good morning"},
            {j:"ありがとうございます",r:"arigatou gozaimasu",e:"Thank you"},
            {j:"すみません",r:"sumimasen",e:"Excuse me"},
            {j:"こんにちは",r:"konnichiwa",e:"Hello"},
            {j:"わたしは学生です",r:"watashi wa gakusei desu",e:"I am a student"},
            {j:"今日はいい天気ですね",r:"kyou wa ii tenki desu ne",e:"The weather is nice today"},
        ];
        let idx = 0;

        function play() {
            if (typeof window.speakJapanese === 'function') window.speakJapanese(words[idx].j, { rate: 0.9 });
        }

        document.getElementById('dict-play-btn').onclick = play;

        document.getElementById('dict-check-btn').onclick = () => {
            const input = document.getElementById('dict-input').value.trim();
            const fb = document.getElementById('dict-feedback');
            fb.style.display = 'block';
            const correct = words[idx].j;
            const romaji = words[idx].r;

            if (input === correct) {
                fb.innerHTML = '<div class="p-2 rounded" style="background:#EDE8F8;color:#9A7BC4;"><i class="bi bi-check-circle-fill"></i> Correct!</div>';
            } else {
                fb.innerHTML = `<div class="p-2 rounded" style="background:#E1E4E7;color:#ee96a4;">
                    <i class="bi bi-x-circle-fill"></i> Not quite.<br>
                    <strong>You wrote:</strong> ${input || '(empty)'}<br>
                    <strong>Correct:</strong> ${correct} <small class="text-muted">(${romaji})</small>
                </div>`;
            }
            document.getElementById('dict-next-btn').style.display = 'inline-block';
        };

        document.getElementById('dict-next-btn').onclick = () => {
            idx = (idx + 1) % words.length;
            document.getElementById('dict-input').value = '';
            document.getElementById('dict-feedback').style.display = 'none';
            document.getElementById('dict-next-btn').style.display = 'none';
            play();
        };

        // Auto-play first word
        setTimeout(play, 500);
    })();
    </script>
}
