@model NihongoAcademy.Models.A2CapstoneViewModel
@{ ViewData["Title"] = "A2 Integrated Completion"; }

<nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Practice</a></li><li class="breadcrumb-item active">A2 Integrated Completion</li></ol></nav>
<div class="na-card mb-4 text-center"><span class="na-badge">A2 CAN-DO CAPSTONE</span><h2 class="mt-3">A2 Integrated Completion <span class="na-subtitle-jp">A2総合修了</span></h2><p class="text-muted mx-auto" style="max-width:720px">Confirm that you can understand connected Japanese and respond independently across all four skills—not only recognise correct answers.</p><div class="display-5 fw-bold @(Model.IsComplete ? "text-success" : "text-na-primary")">@Model.CompletedRequirementCount/5</div><div class="small text-muted">completion requirements met</div>
@if (Model.IsComplete) { <div class="alert alert-success mt-3 mb-0"><strong>✓ A2 stable completion confirmed.</strong> You have demonstrated the full pathway and all four practical skills.</div> } else { <div class="alert alert-info mt-3 mb-0">Complete the remaining requirements below. Every result comes from your saved practice history.</div> }</div>

<partial name="_CompletionCertificate" model="Model" />

<section class="na-card-flat mb-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3"><div><h4 class="mb-1">Foundation Gate <span class="na-subtitle-jp">基礎</span></h4><p class="small text-muted mb-0">All 15 A2 lessons need stable mastery, followed by an 80%+ A2 final assessment.</p></div><span class="na-badge @(Model.FoundationComplete ? "bg-success text-white" : "")">@(Model.FoundationComplete ? "✓ Complete" : "Not complete")</span></div>
<div class="row mt-3 g-3"><div class="col-md-6"><div class="d-flex justify-content-between"><span>Stable A2 lessons</span><strong>@Model.StableLessonCount/@Model.RequiredLessonCount</strong></div><div class="na-progress mt-2"><div class="na-progress-fill" style="width:@(Math.Min(100, Model.StableLessonCount * 100 / Model.RequiredLessonCount))%"></div></div></div><div class="col-md-6"><div class="d-flex justify-content-between"><span>A2 final quiz</span><strong>@Model.BestFinalQuizScore%</strong></div><div class="na-progress mt-2"><div class="na-progress-fill" style="width:@Model.BestFinalQuizScore%"></div></div></div></div><div class="d-flex gap-2 mt-3"><a asp-controller="Lessons" asp-action="Index" class="btn-na-outline btn-sm">View A2 lessons</a><a asp-controller="Quizzes" asp-action="Index" class="btn-na-outline btn-sm">Open final quiz</a></div></section>

<div class="row g-4">@foreach (var skill in Model.Skills) { <div class="col-md-6"><article class="na-card h-100"><div class="d-flex justify-content-between align-items-start"><div class="fs-2">@skill.Icon</div><span class="na-badge @(skill.IsComplete ? "bg-success text-white" : "")">@(skill.IsComplete ? "✓ Stable" : "In progress")</span></div><h4 class="mt-2 mb-1">@skill.Title <span class="na-subtitle-jp">@skill.JapaneseTitle</span></h4><p class="small text-muted">@skill.Requirement</p><div class="na-progress mb-2"><div class="na-progress-fill" style="width:@skill.Score%"></div></div><strong class="small">@skill.ProgressText</strong><div class="mt-3"><a asp-action="@skill.ActionName" asp-route-level="A2" class="btn-na-primary btn-sm">@skill.ActionLabel</a></div></article></div> }</div>
<div class="alert alert-light border mt-4 small"><strong>Stable completion:</strong> skill tasks must be passed again on another date. This prevents a single concentrated session from permanently certifying A2 ability.</div>
