@{
    ViewData["Title"] = "Access Denied";
}

<div class="admin-auth-wrap">
    <div class="admin-auth-card text-center">
        <div class="admin-auth-shield admin-auth-shield--denied">
            <i class="bi bi-shield-x-fill"></i>
        </div>
        <h1 class="admin-auth-title">Access Denied</h1>
        <p class="admin-auth-subtitle">
            <span class="jp">アクセス拒否</span>
        </p>
        <p class="text-muted mt-3">You do not have permission to access this admin page. Please sign in with an administrator account.</p>
        <div class="d-flex gap-2 justify-content-center mt-3">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn-na-primary">
                <i class="bi bi-box-arrow-in-right"></i> Go to login
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn-na-outline">
                <i class="bi bi-house"></i> Back to home
            </a>
        </div>
    </div>
</div>
