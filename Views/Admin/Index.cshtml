@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Admin";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin" }
    },
    Icon = "bi-shield-lock",
    Title = "Admin Dashboard",
    TitleJp = "管理パネル",
    Lead = "Manage platform content, users, and review reported content.",
    ActionsHtml = isSuperAdmin
        ? "<span class=\"na-badge na-badge-role-super\"><i class=\"bi bi-stars\"></i> Super Admin</span>"
        : "<span class=\"na-badge na-badge-role-admin\"><i class=\"bi bi-shield\"></i> Admin (content only)</span>"
})

<div class="d-flex justify-content-end mb-3">
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-na-outline btn-sm" title="Sign out">
            <i class="bi bi-box-arrow-right"></i> Logout
        </button>
    </form>
</div>

<section class="na-card-flat mb-4" aria-labelledby="quality-overview-title">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
        <div><h4 id="quality-overview-title" class="h5 mb-1"><i class="bi bi-clipboard2-check"></i> Curriculum Quality</h4><p class="small text-muted mb-0">Live coverage indicators backed by the same startup validation used by the application.</p></div>
        <span class="na-badge bg-success text-white"><i class="bi bi-check-circle"></i> Startup validation passed</span>
    </div>
    <div class="na-quality-grid mt-3">
        <div><strong>@ViewBag.CoreLessons</strong><span>published core lessons</span></div>
        <div><strong>@ViewBag.LessonActivities</strong><span>structured activities</span></div>
        <div><strong>@ViewBag.ReadingHelpActivities</strong><span>activities with reading help</span></div>
        <div><strong>@ViewBag.LinkedIntegratedTasks/@ViewBag.IntegratedTasks</strong><span>skill tasks linked to lessons</span></div>
    </div>
</section>

<div class="row mb-4">
    <div class="col-md-3 col-6 mb-3">
        <div class="dashboard-metric">
            <div class="metric-value">@ViewBag.TotalLessons</div>
            <div class="metric-label">Total Lessons</div>
            <small class="text-muted">@ViewBag.PublishedLessons published</small>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="dashboard-metric">
            <div class="metric-value">@ViewBag.TotalVocab</div>
            <div class="metric-label">Vocabulary</div>
            <small class="text-muted">Flashcards</small>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="dashboard-metric">
            <div class="metric-value">@ViewBag.TotalQuizzes</div>
            <div class="metric-label">Quizzes</div>
            <small class="text-muted">@ViewBag.TotalQuizQuestions questions</small>
        </div>
    </div>
    <div class="col-md-3 col-6 mb-3">
        <div class="dashboard-metric">
            <div class="metric-value">@ViewBag.TotalUsers</div>
            <div class="metric-label">Users</div>
            <small class="text-muted">@ViewBag.TotalAttempts quiz attempts</small>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="na-card-flat mb-4">
            <h5 class="mb-0"><i class="bi bi-grid-1x2"></i> Quick actions</h5>
            <hr />
            <div class="row g-3">
                <div class="col-md-4">
                    <a asp-controller="AdminModeration" asp-action="Index" class="na-quick-card">
                        <i class="bi bi-flag-fill"></i>
                        <span>Review reports</span>
                        <small>@((int)(ViewBag.PendingReportCount ?? 0)) pending</small>
                    </a>
                </div>
                <div class="col-md-4">
                    <a asp-controller="AdminLogs" asp-action="Index" class="na-quick-card">
                        <i class="bi bi-clock-history"></i>
                        <span>Audit logs</span>
                        <small>Logins &amp; operations</small>
                    </a>
                </div>
                @if (isSuperAdmin)
                {
                    <div class="col-md-4">
                        <a asp-controller="AdminAccounts" asp-action="Index" class="na-quick-card">
                            <i class="bi bi-people-fill"></i>
                            <span>User accounts</span>
                            <small>Roles, reset, disable</small>
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (ViewBag.RecentAttempts != null)
        {
            var recentAttempts = (List<NihongoAcademy.Models.QuizAttempt>)ViewBag.RecentAttempts;
            if (recentAttempts.Count > 0)
            {
                <div class="na-card-flat">
                    <h5><i class="bi bi-clock-history"></i> Recent Quiz Attempts</h5>
                    <hr />
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Quiz</th>
                                    <th>Score</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in recentAttempts)
                                {
                                    <tr>
                                        <td>@a.User?.Email</td>
                                        <td>@a.Quiz?.Title</td>
                                        <td>
                                            <strong style="color: @(a.IsPassed ? "var(--na-secondary)" : "#ee96a4");">
                                                @a.ScorePercentage%
                                            </strong>
                                        </td>
                                        <td><small>@a.AttemptDate.ToString("MMM dd, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
</div>
