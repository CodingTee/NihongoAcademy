@model NihongoAcademy.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<h2><i class="bi bi-pencil"></i> Edit Category</h2>

<div class="row">
    <div class="col-md-6">
        <div class="na-card-flat">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="IconClass" class="form-label"></label>
                    <input asp-for="IconClass" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-na-primary"><i class="bi bi-check-circle"></i> Save</button>
                    <a asp-action="Index" class="btn-na-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
