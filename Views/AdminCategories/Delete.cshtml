@model NihongoAcademy.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h2><i class="bi bi-trash text-danger"></i> Delete Category</h2>

<div class="na-card-flat" style="border-color: #D44;">
    <p class="text-danger">Are you sure you want to delete this category?</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn-na-outline">Cancel</a>
    </form>
</div>
