@model NihongoAcademy.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Categories", Url = Url.Action("Index", "AdminContent", new { type = "category" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Delete Category" }
    },
    Icon = "bi-trash",
    Title = "Delete Category",
    TitleJp = "カテゴリ削除",
    Lead = Model.Name,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Categories", Url = Url.Action("Index", "AdminContent", new { type = "category" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat" style="border-color: #ee96a4;">
    <p class="text-danger">Are you sure you want to delete this category?</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
    <form asp-controller="AdminCategories" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="category" class="btn-na-outline">Cancel</a>
    </form>
</div>
