@model IEnumerable<NihongoAcademy.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Categories" }
    },
    Icon = "bi-grid-3x3-gap",
    Title = "Manage Categories",
    TitleJp = "カテゴリ管理",
    Lead = "Organize lesson, vocabulary, and quiz groupings.",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "New Category", Url = Url.Action("Editor", "AdminContent", new { type = "category", mode = "create" }), Icon = "bi-plus-circle" }
    }
})

<div class="na-card-flat">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Lessons</th>
                    <th>Vocabulary</th>
                    <th>Quizzes</th>
                    <th>Order</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.IconClass))
                            {
                                <i class="@item.IconClass"></i>
                            }
                            <span class="na-badge na-badge-@(item.Name.ToLower())">@item.Name</span>
                        </td>
                        <td><small class="text-muted">@(item.Description?.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)</small></td>
                        <td>@item.Lessons.Count</td>
                        <td>@item.Vocabulary.Count</td>
                        <td>@item.Quizzes.Count</td>
                        <td>@item.DisplayOrder</td>
                        <td>
                            <div class="na-actions">
                                <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="category" asp-route-mode="edit" asp-route-id="@item.Id" class="na-icon-btn" title="Edit" aria-label="Edit category"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="category" asp-route-mode="delete" asp-route-id="@item.Id" class="na-icon-btn na-icon-danger" title="Delete" aria-label="Delete category"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
