@model NihongoAcademy.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Categories", Url = Url.Action("Index", "AdminContent", new { type = "category" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Create Category" }
    },
    Icon = "bi-plus-circle",
    Title = "Create Category",
    TitleJp = "カテゴリ作成",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Categories", Url = Url.Action("Index", "AdminContent", new { type = "category" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="row">
    <div class="col-12">
        <div class="na-card-flat">
            <form asp-controller="AdminCategories" asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="IconClass" class="form-label"></label>
                    <input asp-for="IconClass" class="form-control" placeholder="bi bi-book" />
                    <small class="text-muted">Bootstrap Icons class (e.g. bi bi-book)</small>
                </div>

                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" min="0" value="0" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-na-primary"><i class="bi bi-check-circle"></i> Create</button>
                    <a asp-controller="AdminContent" asp-action="Index" asp-route-type="category" class="btn-na-outline">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
