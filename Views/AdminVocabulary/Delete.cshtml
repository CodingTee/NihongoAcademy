@model NihongoAcademy.Models.Vocabulary

@{
    ViewData["Title"] = "Delete Vocabulary";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Vocabulary", Url = Url.Action("Index", "AdminContent", new { type = "vocabulary" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Delete Word" }
    },
    Icon = "bi-trash",
    Title = "Delete Vocabulary",
    TitleJp = "単語削除",
    Lead = Model.Japanese,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Vocabulary", Url = Url.Action("Index", "AdminContent", new { type = "vocabulary" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat" style="border-color: #ee96a4;">
    <p class="text-danger">Are you sure you want to delete this vocabulary card?</p>
    <dl class="row">
        <dt class="col-sm-3">Japanese</dt>
        <dd class="col-sm-9" style="font-size: 1.3rem;">@Model.Japanese</dd>
        <dt class="col-sm-3">Romaji</dt>
        <dd class="col-sm-9">@Model.Romaji</dd>
        <dt class="col-sm-3">English</dt>
        <dd class="col-sm-9">@Model.English</dd>
    </dl>
    <form asp-controller="AdminVocabulary" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="vocabulary" class="btn-na-outline">Cancel</a>
    </form>
</div>
