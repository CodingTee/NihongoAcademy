@model NihongoAcademy.Models.Vocabulary

@{
    ViewData["Title"] = "Vocabulary Details";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Vocabulary", Url = Url.Action("Index", "AdminContent", new { type = "vocabulary" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Details" }
    },
    Icon = "bi-eye",
    Title = "Vocabulary Details",
    TitleJp = "単語詳細",
    Lead = Model.Japanese,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Vocabulary", Url = Url.Action("Index", "AdminContent", new { type = "vocabulary" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat">
    <dl class="row">
        <dt class="col-sm-3">Japanese</dt>
        <dd class="col-sm-9" style="font-size: 1.5rem;">@Model.Japanese</dd>
        <dt class="col-sm-3">Romaji</dt>
        <dd class="col-sm-9"><em>@Model.Romaji</em></dd>
        <dt class="col-sm-3">English</dt>
        <dd class="col-sm-9">@Model.English</dd>
        <dt class="col-sm-3">Part of Speech</dt>
        <dd class="col-sm-9">@Model.PartOfSpeech</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9"><span class="na-badge na-badge-@(Model.Category?.Name?.ToLower())">@Model.Category?.Name</span></dd>
        <dt class="col-sm-3">JLPT Level</dt>
        <dd class="col-sm-9">N@Model.JlptLevel</dd>
        <dt class="col-sm-3">Example (JP)</dt>
        <dd class="col-sm-9">@Model.ExampleJapanese</dd>
        <dt class="col-sm-3">Example (EN)</dt>
        <dd class="col-sm-9">@Model.ExampleEnglish</dd>
    </dl>
    <div class="mt-3">
        <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="vocabulary" asp-route-mode="edit" asp-route-id="@Model.Id" class="btn-na-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="vocabulary" class="btn-na-outline">Back to List</a>
    </div>
</div>
