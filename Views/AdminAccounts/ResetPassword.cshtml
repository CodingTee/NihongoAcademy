@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewData["Title"] = "Change Password";
    var target = (Microsoft.AspNetCore.Identity.IdentityUser)ViewBag.TargetUser;
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "User Accounts", Url = Url.Action("Index", "AdminAccounts") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Change Password" }
    },
    Icon = "bi-shield-lock",
    Title = "Change Password",
    TitleJp = "パスワード変更",
    Lead = $"Set a new password for {target.Email}. The user will be signed out and must log in again.",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Accounts", Url = Url.Action("Index", "AdminAccounts"), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat" style="max-width:520px;">
    <form asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@target.Id" />
        <div class="mb-3">
            <label class="form-label">New password</label>
            <input type="password" name="newPassword" class="form-control na-input" required minlength="8" />
            <small class="text-muted">At least 8 characters, with digit, lowercase, uppercase and a symbol.</small>
        </div>
        <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <input type="password" name="confirmPassword" class="form-control na-input" required minlength="8" />
        </div>
        <button type="submit" class="btn btn-na-primary" onclick="return confirm('Change password for @target.Email? Their session will be invalidated.')">
            <i class="bi bi-shield-lock-fill"></i> Change password
        </button>
        <a asp-controller="AdminAccounts" asp-action="Index" class="btn btn-na-outline">Cancel</a>
    </form>
</div>
