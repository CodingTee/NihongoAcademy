@model List<NihongoAcademy.Models.ContentReport>
@using NihongoAcademy.Models
@{
    ViewData["Title"] = "Content Reports";
    var postTitles = (System.Collections.Generic.Dictionary<int, string>)ViewBag.PostTitles;
    var commentTexts = (System.Collections.Generic.Dictionary<int, string>)ViewBag.CommentTexts;
    var takenDownPostIds = (System.Collections.Generic.HashSet<int>)ViewBag.TakenDownPostIds;
    var takenDownCommentIds = (System.Collections.Generic.HashSet<int>)ViewBag.TakenDownCommentIds;
    var statusFilter = (NihongoAcademy.Models.ReportStatus?)ViewBag.StatusFilter;
    var typeFilter = (string?)ViewBag.TypeFilter;
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Content Reports" }
    },
    Icon = "bi-flag",
    Title = "Content Reports",
    TitleJp = "通報管理",
    Lead = "Review user reports. Approving a report takes the content down for rectification."
})

<div class="na-card-flat">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h5 class="mb-0"><i class="bi bi-flag"></i> Report queue</h5>
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <select name="status" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                <option value="" selected="@(!statusFilter.HasValue)">All statuses</option>
                <option value="0" selected="@(statusFilter == ReportStatus.Pending)">Pending</option>
                <option value="1" selected="@(statusFilter == ReportStatus.Approved)">Approved</option>
                <option value="2" selected="@(statusFilter == ReportStatus.Dismissed)">Dismissed</option>
            </select>
            <select name="type" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                <option value="" selected="@string.IsNullOrEmpty(typeFilter)">All types</option>
                <option value="Post" selected="@(typeFilter == "Post")">Posts</option>
                <option value="Comment" selected="@(typeFilter == "Comment")">Comments</option>
            </select>
        </form>
    </div>
    <hr />
    @if (!Model.Any())
    {
        <p class="text-muted mb-0"><i class="bi bi-check-circle"></i> No reports match this filter.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Reported</th>
                        <th>Reason</th>
                        <th>Reporter</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        string preview = r.TargetType == ReportTargetType.Post
                            ? (postTitles.TryGetValue(r.TargetId, out var pt) ? pt : "(deleted post)")
                            : (commentTexts.TryGetValue(r.TargetId, out var ct) ? ct : "(deleted comment)");
                        bool isTd = r.TargetType == ReportTargetType.Post ? takenDownPostIds.Contains(r.TargetId) : takenDownCommentIds.Contains(r.TargetId);
                        <tr>
                            <td>
                                <span class="na-badge @(r.TargetType == ReportTargetType.Post ? "na-badge-role-admin" : "na-badge-role-student")">@r.TargetType</span>
                                <span class="na-report-preview">@preview</span>
                                @if (isTd) { <span class="na-badge bg-danger text-white ms-1">taken down</span> }
                            </td>
                            <td>@r.Reason</td>
                            <td>@r.ReporterUser?.Email</td>
                            <td><small>@r.CreatedDate.ToLocalTime().ToString("MMM dd, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</small></td>
                            <td>
                                <span class="na-badge @(r.Status == ReportStatus.Pending ? "bg-warning text-dark" : r.Status == ReportStatus.Approved ? "bg-danger text-white" : "bg-secondary text-white")">@r.Status</span>
                            </td>
                            <td>
                                <a asp-action="Detail" asp-route-id="@r.Id" class="btn btn-sm btn-na-outline">Review</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
