@model IEnumerable<NihongoAcademy.Models.Quiz>

@{
    ViewData["Title"] = "Manage Quizzes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-patch-question"></i> Manage Quizzes</h2>
    <a asp-action="Create" class="btn-na-primary"><i class="bi bi-plus-circle"></i> New Quiz</a>
</div>

<div class="na-card-flat">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Questions</th>
                    <th>Time</th>
                    <th>Pass %</th>
                    <th>Published</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.JapaneseTitle))
                            {
                                <br /><small class="text-na-primary">@item.JapaneseTitle</small>
                            }
                        </td>
                        <td><span class="na-badge na-badge-@(item.Category?.Name?.ToLower())">@item.Category?.Name</span></td>
                        <td>@item.Questions.Count</td>
                        <td>@item.TimeLimitMinutes min</td>
                        <td>@item.PassingScore%</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-muted"></i>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-na-outline" style="color: #D44;"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
