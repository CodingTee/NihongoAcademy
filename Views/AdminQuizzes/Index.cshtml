@model IEnumerable<NihongoAcademy.Models.Quiz>

@{
    ViewData["Title"] = "Manage Quizzes";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Quizzes" }
    },
    Icon = "bi-patch-question",
    Title = "Manage Quizzes",
    TitleJp = "クイズ管理",
    Lead = "Build and maintain practice quizzes.",
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "New Quiz", Url = Url.Action("Editor", "AdminContent", new { type = "quiz", mode = "create" }), Icon = "bi-plus-circle" }
    }
})

<div class="na-card-flat">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Questions</th>
                    <th>Time</th>
                    <th>Pass %</th>
                    <th>Published</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.JapaneseTitle))
                            {
                                <br /><small class="text-na-primary">@item.JapaneseTitle</small>
                            }
                        </td>
                        <td><span class="na-badge na-badge-@(item.Category?.Name?.ToLower())">@item.Category?.Name</span></td>
                        <td>@item.Questions.Count</td>
                        <td>@item.TimeLimitMinutes min</td>
                        <td>@item.PassingScore%</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle text-muted"></i>
                            }
                        </td>
                        <td>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="quiz" asp-route-mode="details" asp-route-id="@item.Id" class="na-icon-btn" title="View" aria-label="View quiz"><i class="bi bi-eye"></i></a>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="quiz" asp-route-mode="edit" asp-route-id="@item.Id" class="na-icon-btn" title="Edit" aria-label="Edit quiz"><i class="bi bi-pencil"></i></a>
                            <a asp-controller="AdminContent" asp-action="Editor" asp-route-type="quiz" asp-route-mode="delete" asp-route-id="@item.Id" class="na-icon-btn na-icon-danger" title="Delete" aria-label="Delete quiz"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
