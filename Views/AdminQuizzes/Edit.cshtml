@model NihongoAcademy.Models.Quiz

@{
    ViewData["Title"] = "Edit Quiz";
    var questions = Model.Questions.OrderBy(q => q.DisplayOrder).ToList();
}

<h2><i class="bi bi-pencil"></i> Edit Quiz</h2>

<div class="row">
    <div class="col-md-8">
        <div class="na-card-flat">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select" asp-items="@(ViewBag.Categories != null ? new SelectList(ViewBag.Categories, "Id", "Name") : null)">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JapaneseTitle" class="form-label"></label>
                    <input asp-for="JapaneseTitle" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="TimeLimitMinutes" class="form-label"></label>
                        <input asp-for="TimeLimitMinutes" class="form-control" type="number" min="1" max="120" />
                        <span asp-validation-for="TimeLimitMinutes" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="PassingScore" class="form-label"></label>
                        <input asp-for="PassingScore" class="form-control" type="number" min="0" max="100" />
                        <span asp-validation-for="PassingScore" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn-na-primary"><i class="bi bi-check-circle"></i> Save Quiz</button>
                <a asp-action="Index" class="btn-na-outline">Back to List</a>
            </form>
        </div>
    </div>

    <div class="col-md-4">
        <div class="na-card-flat" style="background: var(--na-sakura-light);">
            <h6><i class="bi bi-info-circle"></i> Quiz Info</h6>
            <p class="mb-1"><strong>Questions:</strong> @questions.Count</p>
            <p class="mb-0"><strong>Created:</strong> @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
        </div>
    </div>
</div>

<hr class="my-4" />

<h4><i class="bi bi-list-ol"></i> Questions (@questions.Count)</h4>

@if (questions.Any())
{
    @foreach (var q in questions)
    {
        var options = new[] { q.OptionA, q.OptionB, q.OptionC, q.OptionD };
        <div class="na-card-flat mb-3">
            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <strong>Q@(q.DisplayOrder > 0 ? q.DisplayOrder.ToString() : ""). @q.QuestionText</strong>
                    <div class="mt-2">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="quiz-option" style="cursor: default; pointer-events: none; @(i + 1 == q.CorrectOption ? "border-color: var(--na-secondary); background: #E5F8E5;" : "")">
                                <strong>@((char)('A' + i)).</strong> @options[i]
                                @if (i + 1 == q.CorrectOption)
                                {
                                    <i class="bi bi-check-circle-fill text-success float-end"></i>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(q.Explanation))
                    {
                        <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle"></i> @q.Explanation</small>
                    }
                </div>
                <form asp-action="DeleteQuestion" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="questionId" value="@q.Id" />
                    <input type="hidden" name="quizId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-na-outline" style="color: #D44;" onclick="return confirm('Delete this question?')">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>
        </div>
    }
}

<div class="na-card-flat mt-4">
    <h5><i class="bi bi-plus-circle"></i> Add New Question</h5>
    <form asp-action="AddQuestion" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuizId" value="@Model.Id" />

        <div class="mb-2">
            <label class="form-label">Question</label>
            <input name="QuestionText" class="form-control" required />
        </div>

        <div class="row">
            <div class="col-md-6 mb-2">
                <label class="form-label">Option A</label>
                <input name="OptionA" class="form-control" required />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Option B</label>
                <input name="OptionB" class="form-control" required />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Option C</label>
                <input name="OptionC" class="form-control" required />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Option D</label>
                <input name="OptionD" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-2">
                <label class="form-label">Correct Answer</label>
                <select name="CorrectOption" class="form-select" required>
                    <option value="1">A</option>
                    <option value="2">B</option>
                    <option value="3">C</option>
                    <option value="4">D</option>
                </select>
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Display Order</label>
                <input name="DisplayOrder" class="form-control" type="number" min="0" value="@(questions.Count + 1)" />
            </div>
        </div>

        <div class="mb-2">
            <label class="form-label">Explanation (optional)</label>
            <input name="Explanation" class="form-control" />
        </div>

        <button type="submit" class="btn-na-primary"><i class="bi bi-plus-circle"></i> Add Question</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
