@model NihongoAcademy.Models.Quiz

@{
    ViewData["Title"] = "Delete Quiz";
}

@await Html.PartialAsync("_AdminPageHeader", new NihongoAcademy.Models.AdminPageHeaderModel
{
    Trail =
    {
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Admin", Url = Url.Action("Index", "Admin") },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Quizzes", Url = Url.Action("Index", "AdminContent", new { type = "quiz" }) },
        new NihongoAcademy.Models.AdminCrumbItem { Text = "Delete Quiz" }
    },
    Icon = "bi-trash",
    Title = "Delete Quiz",
    TitleJp = "クイズ削除",
    Lead = Model.Title,
    Actions =
    {
        new NihongoAcademy.Models.AdminPageHeaderAction { Text = "Back to Quizzes", Url = Url.Action("Index", "AdminContent", new { type = "quiz" }), Icon = "bi-arrow-left", Outline = true }
    }
})

<div class="na-card-flat" style="border-color: #ee96a4;">
    <p class="text-danger">Are you sure you want to delete this quiz? All associated questions and attempts will also be deleted.</p>
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
        <dt class="col-sm-3">Questions</dt>
        <dd class="col-sm-9">@Model.Questions.Count</dd>
    </dl>
    <form asp-controller="AdminQuizzes" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-controller="AdminContent" asp-action="Index" asp-route-type="quiz" class="btn-na-outline">Cancel</a>
    </form>
</div>
