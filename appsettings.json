{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NihongoAcademyDev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseStartup": {
    "ApplyMigrations": true,
    "SeedOnStartup": false,
    "ValidateCurriculumOnStartup": false,
    "SeedCommunityActivity": false
  },
  "Identity": {
    "RequireConfirmedAccount": false
  },
  "AdminSeed": {
    // Seed-account passwords resolve from here / user-secrets / environment.
    // Leave empty to auto-generate a random password printed to the console on first seed.
    // Keep these OUT of source control; set via:
    //   dotnet user-secrets set "AdminSeed:AdminPassword" "YourStrongPw!"
    "AdminPassword": "",
    "StudentPassword": "",
    "DemoPassword": ""
  },
  "App": {
    "TimeZoneId": "Singapore Standard Time"
  },
  "AllowedHosts": "*"
}
