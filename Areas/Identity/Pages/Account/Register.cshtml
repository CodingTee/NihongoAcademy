@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="na-register-page">
    <span class="na-register-tree" aria-hidden="true"></span>

    <div class="na-login-card">
        <div class="na-login-brand">
            <img src="~/sakura logo.png" alt="NihongoAcademy" class="na-login-brand-mark" />
            <div class="na-login-brand-text">
                <span class="na-login-brand-name">NihongoAcademy</span>
                <span class="na-login-brand-jp">日本語学院</span>
            </div>
        </div>

        <div class="na-login-header">
            <h1>Create your account</h1>
            <p><span class="na-login-wa">はじめまして</span> &mdash; sign up to start your Japanese journey.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="na-login-form">
            <div asp-validation-summary="ModelOnly" class="na-login-validation text-danger" role="alert"></div>

            <div class="na-login-field">
                <label asp-for="Input.Email">Email address</label>
                <div class="na-login-input-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Input.Email" id="Input_Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="na-login-field">
                <label asp-for="Input.Password">Password</label>
                <div class="na-login-input-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Create a password" />
                    <button type="button" class="na-password-toggle" aria-label="Show password" aria-pressed="false">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="na-login-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <div class="na-login-input-wrap">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirm your password" />
                    <button type="button" class="na-password-toggle" aria-label="Show password" aria-pressed="false">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="na-login-field">
                <label asp-for="Input.SecurityQuestion">Security question</label>
                <div class="na-login-input-wrap">
                    <i class="bi bi-patch-question"></i>
                    <select asp-for="Input.SecurityQuestion" id="Input_SecurityQuestion" aria-required="true" required>
                        <option value="" selected disabled>Choose a question&hellip;</option>
                        <option value="What is your mother's name?">What is your mother's name?</option>
                        <option value="What was your first pet's name?">What was your first pet's name?</option>
                        <option value="What city were you born in?">What city were you born in?</option>
                    </select>
                </div>
                <span class="na-login-hint">Used to verify your identity if you forget your password.</span>
                <span asp-validation-for="Input.SecurityQuestion" class="text-danger"></span>
            </div>

            <div class="na-login-field">
                <label asp-for="Input.SecurityAnswer">Security answer</label>
                <div class="na-login-input-wrap">
                    <i class="bi bi-shield-check"></i>
                    <input asp-for="Input.SecurityAnswer" id="Input_SecurityAnswer" autocomplete="off" aria-required="true" placeholder="Your answer (not case-sensitive)" />
                </div>
                <span asp-validation-for="Input.SecurityAnswer" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="na-login-submit">
                Create account <i class="bi bi-arrow-right"></i>
            </button>
        </form>

        <p class="na-login-help">
            Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            document.querySelectorAll('.na-password-toggle').forEach(function (button) {
                var input = button.parentElement.querySelector('input');
                if (!button || !input) return;
                button.addEventListener('click', function () {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.setAttribute('aria-pressed', show ? 'true' : 'false');
                    button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    button.innerHTML = '<i class="bi ' + (show ? 'bi-eye-slash' : 'bi-eye') + '"></i>';
                    input.focus();
                });
            });

        })();
    </script>
}
