@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}

<section class="na-page-hero-v2" aria-label="Manage your account">
    <div class="na-hero-v2-deco" aria-hidden="true">
        <span class="na-hero-v2-glyph na-hero-v2-glyph--a">設</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--b">定</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--c">ア</span>
        <span class="na-hero-v2-glyph na-hero-v2-glyph--d">カ</span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
        <span class="na-hero-v2-petal"></span>
    </div>
    <div class="na-page-hero-v2-inner">
        <span class="na-page-hero-v2-eyebrow"><i class="bi bi-person-gear"></i> Account Settings</span>
        <h1 class="na-page-hero-v2-title">Manage your account <span>アカウント管理</span></h1>
        <p class="na-page-hero-v2-lead">Change your account settings, security options, and personal data.</p>
    </div>
</section>

<div class="na-manage-layout">
    <div class="row">
        <div class="col-md-3 mb-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            <div class="na-manage-card">
                @RenderBody()
            </div>
        </div>
    </div>
</div>
