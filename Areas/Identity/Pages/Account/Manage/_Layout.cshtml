@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    @RenderSection("Scripts", required: false)
}

<div class="na-manage-layout">
    <h1>Manage your account</h1>
    <p class="na-manage-subtitle">Change your account settings</p>
    <hr />
    <div class="row">
        <div class="col-md-3 mb-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            <div class="na-manage-card">
                @RenderBody()
            </div>
        </div>
    </div>
</div>
