@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div>
    <h4 class="mb-4">Personal Data</h4>

    <p class="mb-3 text-muted" style="font-size:0.9rem;">
        Your account contains personal data that you have given us. This page allows you to download or delete that data.
    </p>

    <div class="alert alert-warning mb-4" style="font-size:0.9rem;">
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="./DownloadPersonalData" class="btn-na-outline">
            <i class="bi bi-download"></i> Download
        </a>
        <a asp-page="./DeletePersonalData" class="btn-na-primary" style="background:#D44;">
            <i class="bi bi-trash"></i> Delete
        </a>
    </div>
</div>
