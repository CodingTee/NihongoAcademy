@page
@model OnboardingModel
@{
    ViewData["Title"] = "Welcome & Setup Your Profile";
}

<section class="na-plan-shell">
    <header class="na-plan-header">
        <span class="na-home-kicker"><i class="bi bi-check-circle-fill"></i> Account created · Welcome to NihongoAcademy</span>
        <h1>Set up your profile &amp; study plan</h1>
        <p>Complete your personal profile and learning goals below. All fields with <span class="text-danger">*</span> are required.</p>
        <div class="na-auth-steps" aria-label="Account setup steps">
            <div class="is-complete"><span><i class="bi bi-check"></i></span><strong>Account</strong><small>Completed</small></div>
            <div class="is-current"><span>2</span><strong>Profile &amp; Plan</strong><small>Customize identity &amp; goals</small></div>
            <div><span>3</span><strong>Start learning</strong><small>Explore Academy</small></div>
        </div>
    </header>

    <form method="post" enctype="multipart/form-data" asp-route-returnUrl="@Model.ReturnUrl" class="na-plan-form" id="onboardingForm" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger mb-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Please correct the items highlighted below:</strong>
                <div asp-validation-summary="All" class="mt-2 text-danger small"></div>
            </div>
        }

        <!-- Hidden Avatar Config Fields -->
        <input type="hidden" asp-for="Input.AvatarJson" id="onboardingAvatarJson" />
        <input type="hidden" asp-for="Input.AvatarMode" id="onboardingAvatarMode" />

        @* ===== STEP 1: Personal Identity & Avatar ===== *@
        <div class="na-card mb-4 p-4" style="border-radius: var(--na-radius-lg, 16px);">
            <h4 class="mb-3" style="color: var(--na-brand); font-weight: 700;">
                <i class="bi bi-person-badge"></i> 1. Your Personal Identity &amp; Avatar
            </h4>
            
            <div class="row g-3 mb-3">
                <div class="col-md-6 na-field-wrap">
                    <label asp-for="Input.Username" class="form-label font-weight-bold">
                        Username / Handle <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted fw-bold">&#64;</span>
                        <input asp-for="Input.Username" class="form-control" id="onboarding-username" placeholder="e.g. sakura_learner" required autocomplete="username" />
                    </div>
                    <div class="na-field-feedback" id="feedback-onboarding-username"></div>
                    <span asp-validation-for="Input.Username" class="text-danger small d-block mt-1"></span>
                    <small class="text-muted d-block mt-1">Your unique handle across leaderboards and community (3-32 characters: letters, numbers, dot, hyphen or underscore).</small>
                </div>

                <div class="col-md-6 na-field-wrap">
                    <label asp-for="Input.DisplayName" class="form-label font-weight-bold">
                        Display Name / Nickname <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.DisplayName" class="form-control" id="onboarding-displayname" placeholder="e.g. SakuraLearner" required />
                    <div class="na-field-feedback" id="feedback-onboarding-displayname"></div>
                    <span asp-validation-for="Input.DisplayName" class="text-danger small d-block mt-1"></span>
                    <small class="text-muted d-block mt-1">Shown publicly to other learners (2-50 characters).</small>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6 na-field-wrap">
                    <label asp-for="Input.NativeLanguage" class="form-label font-weight-bold">
                        Native Language <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Input.NativeLanguage" class="form-select" id="onboarding-nativelang" required>
                        <option value="">Select your native language...</option>
                        <option value="English">English</option>
                        <option value="中文">中文 (Chinese)</option>
                        <option value="日本語">日本語 (Japanese)</option>
                        <option value="Español">Español (Spanish)</option>
                        <option value="Français">Français (French)</option>
                        <option value="Deutsch">Deutsch (German)</option>
                        <option value="한국어">한국어 (Korean)</option>
                        <option value="Tiếng Việt">Tiếng Việt (Vietnamese)</option>
                        <option value="Bahasa Indonesia">Bahasa Indonesia</option>
                        <option value="Other">Other</option>
                    </select>
                    <div class="na-field-feedback" id="feedback-onboarding-nativelang"></div>
                </div>

                <div class="col-md-6 na-field-wrap">
                    <label asp-for="Input.Country" class="form-label font-weight-bold">
                        Country / Region <span class="text-danger">*</span>
                    </label>
                    <select asp-for="Input.Country" class="form-select" id="onboarding-country" required>
                        <option value="">Select your country...</option>
                        <option value="United States">United States</option>
                        <option value="Japan">Japan</option>
                        <option value="China">China</option>
                        <option value="United Kingdom">United Kingdom</option>
                        <option value="Canada">Canada</option>
                        <option value="Australia">Australia</option>
                        <option value="Singapore">Singapore</option>
                        <option value="Malaysia">Malaysia</option>
                        <option value="Germany">Germany</option>
                        <option value="France">France</option>
                        <option value="Other">Other</option>
                    </select>
                    <div class="na-field-feedback" id="feedback-onboarding-country"></div>
                </div>
            </div>

            <!-- Avatar Selection Mode Switcher -->
            <label class="form-label font-weight-bold mb-2">Global Avatar (Shown on Navbar, Profile, Community)</label>
            <div class="d-flex gap-2 mb-3">
                <button type="button" class="btn btn-outline-primary btn-sm active" id="btnModeGenerated" onclick="switchAvatarTab('generated')">
                    <i class="bi bi-palette"></i> Create Custom 2D Avatar
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnModeUploaded" onclick="switchAvatarTab('uploaded')">
                    <i class="bi bi-upload"></i> Upload Photo
                </button>
            </div>

            <!-- Tab 1: 2D Custom Avatar Builder -->
            <div id="tabAvatarGenerated" class="p-3 bg-light rounded-3">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-3 mb-md-0">
                        <div class="avatar-preview-card p-3 bg-white rounded-3 shadow-sm border text-center">
                            <div id="onboarding-avatar-preview" data-size="140" style="margin: 0 auto; width: 140px; height: 140px; border-radius: 50%; overflow: hidden; border: 3px solid var(--na-brand, #ff8da1);"></div>
                            <small class="text-muted d-block mt-2 font-weight-bold">Live Preview</small>
                        </div>
                        <button type="button" id="btnRandomOnboarding" class="btn btn-sm btn-outline-secondary mt-3 w-100">
                            <i class="bi bi-dice-5"></i> Randomize Avatar
                        </button>
                    </div>
                    <div class="col-md-8">
                        <div id="onboarding-avatar-controls" class="avatar-controls-container"></div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Upload Photo -->
            <div id="tabAvatarUploaded" class="p-3 bg-light rounded-3 d-none">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <div id="onboarding-photo-preview-wrap" style="width: 100px; height: 100px; border-radius: 50%; overflow: hidden; border: 2px dashed rgba(238, 150, 164, 0.6); display: grid; place-items: center; background: #fff;">
                        <i class="bi bi-person-bounding-box text-muted fs-2" id="onboarding-photo-icon"></i>
                        <img id="onboarding-photo-img" src="" alt="Avatar preview" style="width: 100%; height: 100%; object-fit: cover; display: none;" />
                    </div>
                    <div style="flex: 1; min-width: 220px;">
                        <label asp-for="Input.AvatarFile" class="form-label font-weight-bold small mb-1">Select Photo (JPG, PNG, GIF, WebP · max 3 MB)</label>
                        <input asp-for="Input.AvatarFile" id="onboarding-avatar-file" type="file" class="form-control form-control-sm" accept="image/*" />
                        <div class="na-field-feedback" id="feedback-onboarding-photo"></div>
                        <div id="onboarding-photo-status"></div>
                    </div>
                </div>
            </div>
        </div>

        @* ===== STEP 2: Study Plan ===== *@
        <div class="na-card mb-4 p-4" style="border-radius: var(--na-radius-lg, 16px);">
            <h4 class="mb-3" style="color: var(--na-brand); font-weight: 700;">
                <i class="bi bi-compass"></i> 2. Your Learning Plan
            </h4>

            <fieldset class="na-plan-question mb-4" id="group-learning-goal">
                <legend class="h6 mb-2 font-weight-bold d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>Why are you learning Japanese? <span class="text-danger">*</span></div>
                    <div class="badge bg-light text-muted border fw-normal" style="font-size: 0.75rem;"><i class="bi bi-check2-square text-na-primary"></i> Multi-select (choose 1 or more)</div>
                </legend>
                <div class="na-plan-options">
                    <label class="@(Model.Input.LearningGoals.Contains("Travel & culture") ? "is-selected" : "")">
                        <input type="checkbox" name="Input.LearningGoals" value="Travel & culture" @(Model.Input.LearningGoals.Contains("Travel & culture") ? "checked" : "") />
                        <i class="bi bi-airplane"></i><strong>Travel &amp; culture</strong>
                    </label>
                    <label class="@(Model.Input.LearningGoals.Contains("Work & career") ? "is-selected" : "")">
                        <input type="checkbox" name="Input.LearningGoals" value="Work & career" @(Model.Input.LearningGoals.Contains("Work & career") ? "checked" : "") />
                        <i class="bi bi-briefcase"></i><strong>Work &amp; career</strong>
                    </label>
                    <label class="@(Model.Input.LearningGoals.Contains("Study & exams") ? "is-selected" : "")">
                        <input type="checkbox" name="Input.LearningGoals" value="Study & exams" @(Model.Input.LearningGoals.Contains("Study & exams") ? "checked" : "") />
                        <i class="bi bi-mortarboard"></i><strong>Study &amp; exams</strong>
                    </label>
                    <label class="@(Model.Input.LearningGoals.Contains("Anime & entertainment") ? "is-selected" : "")">
                        <input type="checkbox" name="Input.LearningGoals" value="Anime & entertainment" @(Model.Input.LearningGoals.Contains("Anime & entertainment") ? "checked" : "") />
                        <i class="bi bi-controller"></i><strong>Anime &amp; entertainment</strong>
                    </label>
                </div>
                <div class="na-field-feedback" id="feedback-onboarding-goal"></div>
                <span asp-validation-for="Input.LearningGoals" class="text-danger small d-block mt-2"></span>
            </fieldset>

            <fieldset class="na-plan-question mb-4" id="group-current-level">
                <legend class="h6 mb-2 font-weight-bold">What is your current level? <span class="text-danger">*</span></legend>
                <div class="na-plan-options">
                    <label><input asp-for="Input.CurrentLevel" type="radio" value="Absolute beginner" required /><i class="bi bi-1-circle"></i><strong>Absolute beginner</strong></label>
                    <label><input asp-for="Input.CurrentLevel" type="radio" value="Knows hiragana" /><i class="bi bi-2-circle"></i><strong>I know hiragana</strong></label>
                    <label><input asp-for="Input.CurrentLevel" type="radio" value="Conversational basics" /><i class="bi bi-3-circle"></i><strong>Conversational basics</strong></label>
                    <label><input asp-for="Input.CurrentLevel" type="radio" value="Intermediate or above" /><i class="bi bi-4-circle"></i><strong>Intermediate or above</strong></label>
                </div>
                <div class="na-field-feedback" id="feedback-onboarding-level"></div>
                <span asp-validation-for="Input.CurrentLevel" class="text-danger small d-block mt-2"></span>
            </fieldset>

            <fieldset class="na-plan-question mb-2" id="group-age-group">
                <legend class="h6 mb-2 font-weight-bold">Which age group are you in? <span class="text-danger">*</span></legend>
                <div class="na-plan-options">
                    <label><input asp-for="Input.AgeGroup" type="radio" value="Under 18" required /><i class="bi bi-emoji-smile"></i><strong>Under 18</strong></label>
                    <label><input asp-for="Input.AgeGroup" type="radio" value="18 – 24" /><i class="bi bi-person"></i><strong>18 – 24</strong></label>
                    <label><input asp-for="Input.AgeGroup" type="radio" value="25 – 34" /><i class="bi bi-person-badge"></i><strong>25 – 34</strong></label>
                    <label><input asp-for="Input.AgeGroup" type="radio" value="35 or older" /><i class="bi bi-people"></i><strong>35 or older</strong></label>
                </div>
                <div class="na-field-feedback" id="feedback-onboarding-age"></div>
                <span asp-validation-for="Input.AgeGroup" class="text-danger small d-block mt-2"></span>
            </fieldset>
        </div>

        <button type="submit" id="onboardingSubmitBtn" class="btn-na-primary na-plan-submit w-100 py-3" style="font-size: 1.1rem;">
            Save Profile &amp; Start Learning <i class="bi bi-arrow-right"></i>
        </button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/avatar-builder.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Study plan option selection styling
            document.querySelectorAll('.na-plan-options input').forEach(function (input) {
                function updateItem() {
                    if (input.type === 'checkbox') {
                        input.closest('label').classList.toggle('is-selected', input.checked);
                    } else {
                        document.querySelectorAll('input[name="' + input.name + '"]').forEach(function (item) {
                            item.closest('label').classList.toggle('is-selected', item.checked);
                        });
                    }
                }
                input.addEventListener('change', updateItem);
                updateItem();
            });

            // Live validation clearance on goal checkbox selection
            document.querySelectorAll('input[name="Input.LearningGoals"]').forEach(function (cb) {
                cb.addEventListener('change', function () {
                    var anyChecked = document.querySelectorAll('input[name="Input.LearningGoals"]:checked').length > 0;
                    var feedbackGoal = document.getElementById('feedback-onboarding-goal');
                    if (feedbackGoal && anyChecked) {
                        feedbackGoal.classList.remove('is-visible', 'is-invalid');
                    }
                });
            });

            // Initialize AvatarBuilder controls
            if (window.AvatarBuilder) {
                AvatarBuilder.init({
                    preview: '#onboarding-avatar-preview',
                    controls: '#onboarding-avatar-controls',
                    input: '#onboardingAvatarJson',
                    randomButton: '#btnRandomOnboarding'
                });
            }

            // ==========================================
            // REAL-TIME INSTANT INLINE VALIDATION ENGINE
            // ==========================================
            var usernameInput = document.getElementById('onboarding-username');
            var displayNameInput = document.getElementById('onboarding-displayname');
            var nativeLangSelect = document.getElementById('onboarding-nativelang');
            var countrySelect = document.getElementById('onboarding-country');
            var avatarFileInput = document.getElementById('onboarding-avatar-file');
            var form = document.getElementById('onboardingForm');

            function setFeedback(inputEl, feedbackEl, isValid, message, isChecking) {
                if (!feedbackEl) return;
                feedbackEl.classList.remove('is-valid', 'is-invalid', 'is-checking', 'is-visible');
                inputEl.classList.remove('is-valid', 'is-invalid');

                if (isChecking) {
                    feedbackEl.classList.add('is-checking', 'is-visible');
                    feedbackEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> ' + message;
                    return;
                }

                if (isValid) {
                    inputEl.classList.add('is-valid');
                    feedbackEl.classList.add('is-valid', 'is-visible');
                    feedbackEl.innerHTML = '<i class="bi bi-check-circle-fill"></i> ' + message;
                } else {
                    inputEl.classList.add('is-invalid');
                    feedbackEl.classList.add('is-invalid', 'is-visible');
                    feedbackEl.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> ' + message;
                }
            }

            // --- 1. Real-time Username Validation ---
            var usernameTimer = null;
            var isUsernameValid = false;

            function validateUsernameLive() {
                var val = usernameInput.value.trim();
                var feedback = document.getElementById('feedback-onboarding-username');

                if (!val) {
                    isUsernameValid = false;
                    setFeedback(usernameInput, feedback, false, 'Username cannot be empty.');
                    return;
                }
                if (val.length < 3 || val.length > 32) {
                    isUsernameValid = false;
                    setFeedback(usernameInput, feedback, false, 'Username must be between 3 and 32 characters (currently ' + val.length + ').');
                    return;
                }
                var regex = /^[a-zA-Z0-9_.-]+$/;
                if (!regex.test(val)) {
                    isUsernameValid = false;
                    setFeedback(usernameInput, feedback, false, 'Only letters, numbers, dot (.), hyphen (-) or underscore (_) allowed.');
                    return;
                }

                // Debounced server check for uniqueness
                clearTimeout(usernameTimer);
                setFeedback(usernameInput, feedback, true, 'Checking availability...', true);
                usernameTimer = setTimeout(function () {
                    fetch('?handler=CheckUsername&username=' + encodeURIComponent(val))
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.available) {
                                isUsernameValid = true;
                                setFeedback(usernameInput, feedback, true, 'Username is available!');
                            } else {
                                isUsernameValid = false;
                                setFeedback(usernameInput, feedback, false, data.message || 'This username is already taken.');
                            }
                        })
                        .catch(function () {
                            isUsernameValid = true;
                            setFeedback(usernameInput, feedback, true, 'Username format is valid.');
                        });
                }, 350);
            }

            if (usernameInput) {
                usernameInput.addEventListener('input', validateUsernameLive);
                usernameInput.addEventListener('blur', validateUsernameLive);
                if (usernameInput.value.trim()) {
                    validateUsernameLive();
                }
            }

            // --- 2. Real-time Display Name Validation ---
            var isDisplayNameValid = false;
            function validateDisplayNameLive() {
                var val = displayNameInput.value.trim();
                var feedback = document.getElementById('feedback-onboarding-displayname');
                if (!val) {
                    isDisplayNameValid = false;
                    setFeedback(displayNameInput, feedback, false, 'Display name is required.');
                    return;
                }
                if (val.length < 2 || val.length > 50) {
                    isDisplayNameValid = false;
                    setFeedback(displayNameInput, feedback, false, 'Must be between 2 and 50 characters (currently ' + val.length + ').');
                    return;
                }
                isDisplayNameValid = true;
                setFeedback(displayNameInput, feedback, true, 'Display name looks great!');
            }

            if (displayNameInput) {
                displayNameInput.addEventListener('input', validateDisplayNameLive);
                displayNameInput.addEventListener('blur', validateDisplayNameLive);
                if (displayNameInput.value.trim()) {
                    validateDisplayNameLive();
                }
            }

            // --- 3. Dropdowns (Native Language & Country) ---
            function validateSelectLive(selectEl, feedbackId, fieldName) {
                var val = selectEl.value;
                var feedback = document.getElementById(feedbackId);
                if (!val) {
                    setFeedback(selectEl, feedback, false, 'Please select your ' + fieldName + '.');
                    return false;
                }
                setFeedback(selectEl, feedback, true, fieldName + ' selected.');
                return true;
            }

            if (nativeLangSelect) {
                nativeLangSelect.addEventListener('change', function () {
                    validateSelectLive(nativeLangSelect, 'feedback-onboarding-nativelang', 'native language');
                });
            }
            if (countrySelect) {
                countrySelect.addEventListener('change', function () {
                    validateSelectLive(countrySelect, 'feedback-onboarding-country', 'country/region');
                });
            }

            // --- 4. Avatar File Live Validation & Instant Preview ---
            if (avatarFileInput) {
                avatarFileInput.addEventListener('change', function () {
                    var file = avatarFileInput.files && avatarFileInput.files[0];
                    var feedback = document.getElementById('feedback-onboarding-photo');
                    var img = document.getElementById('onboarding-photo-img');
                    var icon = document.getElementById('onboarding-photo-icon');
                    var status = document.getElementById('onboarding-photo-status');

                    if (!file) {
                        if (feedback) feedback.classList.remove('is-visible');
                        if (img) img.style.display = 'none';
                        if (icon) icon.style.display = 'block';
                        return;
                    }

                    // Validate file size (max 3MB)
                    if (file.size > 3 * 1024 * 1024) {
                        avatarFileInput.value = '';
                        setFeedback(avatarFileInput, feedback, false, 'File too large (' + (file.size / 1024 / 1024).toFixed(1) + ' MB). Maximum allowed size is 3 MB.');
                        if (img) img.style.display = 'none';
                        if (icon) icon.style.display = 'block';
                        return;
                    }

                    // Validate file extension
                    var allowedExts = ['jpg', 'jpeg', 'png', 'gif', 'webp'];
                    var ext = file.name.split('.').pop().toLowerCase();
                    if (allowedExts.indexOf(ext) === -1) {
                        avatarFileInput.value = '';
                        setFeedback(avatarFileInput, feedback, false, 'Invalid format (.' + ext + '). Only JPG, PNG, GIF or WebP are allowed.');
                        if (img) img.style.display = 'none';
                        if (icon) icon.style.display = 'block';
                        return;
                    }

                    // Valid file: live preview immediately
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        if (img) {
                            img.src = e.target.result;
                            img.style.display = 'block';
                        }
                        if (icon) icon.style.display = 'none';
                    };
                    reader.readAsDataURL(file);

                    setFeedback(avatarFileInput, feedback, true, 'Photo verified: ' + file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB)');
                    switchAvatarTab('uploaded');
                });
            }

            // --- 5. Form Submit Validation Guard ---
            if (form) {
                form.addEventListener('submit', function (e) {
                    var errors = [];

                    validateUsernameLive();
                    validateDisplayNameLive();
                    var nativeValid = validateSelectLive(nativeLangSelect, 'feedback-onboarding-nativelang', 'native language');
                    var countryValid = validateSelectLive(countrySelect, 'feedback-onboarding-country', 'country/region');

                    // Check radio / checkbox groups
                    var goalChecked = document.querySelectorAll('input[name="Input.LearningGoals"]:checked').length > 0;
                    var levelChecked = document.querySelector('input[name="Input.CurrentLevel"]:checked');
                    var ageChecked = document.querySelector('input[name="Input.AgeGroup"]:checked');

                    var feedbackGoal = document.getElementById('feedback-onboarding-goal');
                    var feedbackLevel = document.getElementById('feedback-onboarding-level');
                    var feedbackAge = document.getElementById('feedback-onboarding-age');

                    if (!goalChecked) {
                        errors.push(document.getElementById('group-learning-goal'));
                        if (feedbackGoal) {
                            feedbackGoal.className = 'na-field-feedback is-invalid is-visible';
                            feedbackGoal.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> Please select why you are learning Japanese.';
                        }
                    } else if (feedbackGoal) {
                        feedbackGoal.classList.remove('is-visible');
                    }

                    if (!levelChecked) {
                        errors.push(document.getElementById('group-current-level'));
                        if (feedbackLevel) {
                            feedbackLevel.className = 'na-field-feedback is-invalid is-visible';
                            feedbackLevel.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> Please select your current level.';
                        }
                    } else if (feedbackLevel) {
                        feedbackLevel.classList.remove('is-visible');
                    }

                    if (!ageChecked) {
                        errors.push(document.getElementById('group-age-group'));
                        if (feedbackAge) {
                            feedbackAge.className = 'na-field-feedback is-invalid is-visible';
                            feedbackAge.innerHTML = '<i class="bi bi-exclamation-circle-fill"></i> Please select your age group.';
                        }
                    } else if (feedbackAge) {
                        feedbackAge.classList.remove('is-visible');
                    }

                    if (!isUsernameValid) errors.push(usernameInput);
                    if (!isDisplayNameValid) errors.push(displayNameInput);
                    if (!nativeValid) errors.push(nativeLangSelect);
                    if (!countryValid) errors.push(countrySelect);

                    if (errors.length > 0) {
                        e.preventDefault();
                        var firstErr = errors[0];
                        if (firstErr) {
                            firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            firstErr.classList.add('na-input-shake');
                            setTimeout(function () { firstErr.classList.remove('na-input-shake'); }, 400);
                            if (firstErr.focus) firstErr.focus();
                        }
                    }
                });
            }
        });

        function switchAvatarTab(mode) {
            document.getElementById('onboardingAvatarMode').value = mode;
            var tabGen = document.getElementById('tabAvatarGenerated');
            var tabUp = document.getElementById('tabAvatarUploaded');
            var btnGen = document.getElementById('btnModeGenerated');
            var btnUp = document.getElementById('btnModeUploaded');

            if (mode === 'generated') {
                tabGen.classList.remove('d-none');
                tabUp.classList.add('d-none');
                btnGen.classList.add('active', 'btn-outline-primary');
                btnGen.classList.remove('btn-outline-secondary');
                btnUp.classList.remove('active', 'btn-outline-primary');
                btnUp.classList.add('btn-outline-secondary');
            } else {
                tabGen.classList.add('d-none');
                tabUp.classList.remove('d-none');
                btnUp.classList.add('active', 'btn-outline-primary');
                btnUp.classList.remove('btn-outline-secondary');
                btnGen.classList.remove('active', 'btn-outline-primary');
                btnGen.classList.add('btn-outline-secondary');
            }
        }
    </script>
}
