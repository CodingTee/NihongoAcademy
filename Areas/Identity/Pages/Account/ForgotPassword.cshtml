@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="na-register-page">
    <span class="na-register-tree" aria-hidden="true"></span>

    <div class="na-login-card">
        <div class="na-login-brand">
            <img src="~/sakura logo.png" alt="NihongoAcademy" class="na-login-brand-mark" />
            <div class="na-login-brand-text">
                <span class="na-login-brand-name">NihongoAcademy</span>
                <span class="na-login-brand-jp">日本語学院</span>
            </div>
        </div>

        <div class="na-login-header">
            <h1>Reset your password</h1>
            @if (Model.Done)
            {
                <p><span class="na-login-wa">パスワードを再設定</span> &mdash; your request has been processed.</p>
            }
            else if (Model.Step == 1)
            {
                <p>Enter your email address and we'll ask you a security question to verify it's you.</p>
            }
            else
            {
                <p>Answer your security question, then choose a new password.</p>
            }
        </div>

        @if (Model.Done)
        {
            <div class="na-fp-sent" role="status">
                <i class="bi bi-patch-check"></i>
                <div class="na-fp-sent-body">
                    <strong>If that account exists, its password has been updated</strong>
                    <span>You can now <a asp-page="./Login">sign in</a> with your new password.</span>
                </div>
            </div>
        }
        else if (Model.Step == 1)
        {
            <form method="post" class="na-login-form">
                <div asp-validation-summary="ModelOnly" class="na-login-validation text-danger" role="alert"></div>

                <input type="hidden" asp-for="Step" />

                <div class="na-login-field">
                    <label asp-for="Input.Email">Email address</label>
                    <div class="na-login-input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Input.Email" id="Input_Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="na-login-submit">Continue <i class="bi bi-arrow-right"></i></button>

                <p class="na-login-help">Remembered it? <a asp-page="./Login">Back to sign in</a></p>
            </form>
        }
        else
        {
            <form method="post" class="na-login-form">
                <div asp-validation-summary="ModelOnly" class="na-login-validation text-danger" role="alert"></div>

                <input type="hidden" asp-for="Step" />
                <input type="hidden" asp-for="Input.Email" />

                <div class="na-login-field">
                    <label>Security question</label>
                    <div class="na-login-question" role="note">@Model.SecurityQuestion</div>
                </div>

                <div class="na-login-field">
                    <label asp-for="Input.SecurityAnswer">Your answer</label>
                    <div class="na-login-input-wrap">
                        <i class="bi bi-shield-check"></i>
                        <input asp-for="Input.SecurityAnswer" id="Input_SecurityAnswer" autocomplete="off" aria-required="true" placeholder="Not case-sensitive" />
                    </div>
                    <span asp-validation-for="Input.SecurityAnswer" class="text-danger"></span>
                </div>

                <div class="na-login-field">
                    <label asp-for="Input.NewPassword">New password</label>
                    <div class="na-login-input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Input.NewPassword" autocomplete="new-password" aria-required="true" placeholder="At least 8 characters" />
                        <button type="button" class="na-password-toggle" aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>

                <div class="na-login-field">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <div class="na-login-input-wrap">
                        <i class="bi bi-lock-fill"></i>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Repeat the new password" />
                        <button type="button" class="na-password-toggle" aria-label="Show password" aria-pressed="false">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="na-login-submit">Reset password <i class="bi bi-arrow-right"></i></button>

                <p class="na-login-help">Remembered it? <a asp-page="./Login">Back to sign in</a></p>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            /* ---------- password visibility toggles ---------- */
            document.querySelectorAll('.na-password-toggle').forEach(function (button) {
                var input = button.parentElement.querySelector('input');
                if (!button || !input) return;
                button.addEventListener('click', function () {
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.setAttribute('aria-pressed', show ? 'true' : 'false');
                    button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    button.innerHTML = '<i class="bi ' + (show ? 'bi-eye-slash' : 'bi-eye') + '"></i>';
                    input.focus();
                });
            });
        })();
    </script>
}
